// T2.9: `GET|HEAD /v2/<name>/blobs/<digest>`. The local backend answers the
// bytes itself; the S3 backend answers 307 with a presigned Location, so the
// client downloads from the object store instead of through the registry.
// HEAD always answers metadata directly — a redirect on HEAD would force a
// second request just to learn a length.
//
// A blob must be linked to the repository (the `blobs` table owns that
// relation) and must exist in the backend; either miss is 404 BLOB_UNKNOWN.
// The digest is validated before any lookup, so `sha256:` garbage cannot reach
// a store path. HEAD and GET both consult the backend's head first: a presigned
// URL for a missing object would otherwise answer 404 at the CDN, not here.
//
// The link lookup is an interface (BlobLinks), like the manifest store, so the
// route runs in the interpreter against a fake; DbBlobLinks is the SQLite
// implementation, opening a short-lived connection per request.
// Spec: docs/spec/registry-blobs.md.

require "httpd"
require "json"

const route_prefix = "/v2/"
const route_marker = "/blobs/"
const content_type = "application/octet-stream"

class BlobLink {
  def init(found Bool, size Int64) {
    self.found = found
    self.size = size
  }
}

def absent_link() BlobLink {
  return BlobLink.new(false, -1)
}

interface BlobLinks {
  def linked(repository String, digest String) (R, BlobLink)
}

class DbBlobLinks {
  def init(db_path String) {
    self.db_path = db_path
  }

  def linked(repository String, digest String) (R, BlobLink) {
    const db = registry.db.connect(self.db_path)
    const repository_id = db.repository_id(repository)
    if repository_id == 0 {
      db.close()
      return (R.ok, absent_link())
    }
    const size = db.blob_size(repository_id, digest)
    db.close()
    if size < 0 {
      return (R.ok, absent_link())
    }
    return (R.ok, BlobLink.new(true, size))
  }
}

// ---------------------------------------------------------------------------
// Routing.

def is_route(path String) Bool {
  if !path.starts_with(route_prefix) {
    return false
  }
  return path.index_of(route_marker) >= 0
}

// "/v2/acme/app/blobs/sha256:..." → ("acme/app", "sha256:...")
def split(path String) (String, String) {
  if !path.starts_with(route_prefix) {
    return ("", "")
  }
  const rest = path.substring(route_prefix.length(), path.length() - route_prefix.length())
  const at = rest.index_of(route_marker)
  if at <= 0 {
    return ("", "")
  }
  const repository = rest.substring(0, at)
  const digest = rest.substring(at + route_marker.length(), rest.length() - at - route_marker.length())
  if digest == "" || digest.index_of("/") >= 0 {
    return ("", "")
  }
  return (repository, digest)
}

def handle(req httpd.Request, links BlobLinks, store registry.blobstore.BlobStore) httpd.Response {
  if req.method != "GET" && req.method != "HEAD" {
    return registry.api.method_not_allowed("GET, HEAD")
  }
  const parts = split(req.path)
  const repository = parts[0]
  const digest = parts[1]
  if repository == "" || digest == "" {
    return registry.api.not_found(registry.api.code_blob_unknown, "blob unknown", req.path)
  }
  if registry.digest.hex(digest) == "" {
    return registry.api.bad_request(registry.api.code_digest_invalid, "invalid digest", digest)
  }
  case links.linked(repository, digest) {
    (R.error, why) then { return registry.api.server_error("blob lookup failed", why) }
    (R.ok, link) then {
      if !link.found {
        return registry.api.not_found(registry.api.code_blob_unknown, "blob unknown", repository + "@" + digest)
      }
      case store.head(digest) {
        (R.error, why) then { return registry.api.server_error("blob store lookup failed", why) }
        (R.ok, info) then {
          if !info.exists {
            return registry.api.not_found(registry.api.code_blob_unknown, "blob unknown", repository + "@" + digest)
          }
          if req.method == "HEAD" {
            return head_response(digest, size_of(info.size, link.size))
          }
          if registry.cache.not_requested(req, digest) {
            return registry.cache.not_modified(registry.cache.blob_headers(digest))
          }
          const url = store.presign_get(digest, 0)
          if url != "" {
            return httpd.response(307, [("Location", url), ("Cache-Control", registry.cache.redirect_cache_control), ("Docker-Content-Digest", digest)], "")
          }
          case parse_range(req.header("Range")) {
            (R.error, why) then { return registry.api.bad_request(registry.api.code_digest_invalid, "invalid Range", why) }
            (R.ok, window) then {
              return ranged_response(store, digest, info.size, window)
            }
          }
          case store.get(digest) {
            (R.error, why) then {
              if registry.blobstore.is_not_found(why) {
                return registry.api.not_found(registry.api.code_blob_unknown, "blob unknown", repository + "@" + digest)
              }
              return registry.api.server_error("blob read failed", why)
            }
            (R.ok, body) then {
              return httpd.response(200, registry.cache.with_cache([
                ("Content-Type", content_type),
                ("Docker-Content-Digest", digest),
                ("Content-Length", body.to_bytes().length().to_string())
              ], registry.cache.blob_headers(digest)), body)
            }
          }
        }
      }
    }
  }
}

// ---- Range windows --------------------------------------------------------
// A response body is written in one `send` and the runtime treats a full
// socket buffer (EAGAIN) as fatal, so any single body above roughly 64 KiB
// can die mid-transfer. The route therefore serves bounded windows: a
// `Range: bytes=A-` (or a wider `bytes=A-B`) answers 206 with at most
// `blob_range_window` bytes and a Content-Range naming exactly what was
// sent — legal HTTP, and it lets a resuming client (the pokerface pull)
// walk a multi-megabyte blob in safe slices. A request without Range keeps
// the plain 200 full body (small blobs, and every client that does not
// resume).

const blob_range_window = 32768

// (start, end) inclusive; start < 0 means "no Range header".
def parse_range(header String) (R, (Int64, Int64)) {
  const t = header.trim()
  if t == "" {
    return (R.ok, (-1, -1))
  }
  if !t.starts_with("bytes=") {
    return (R.error, "only bytes= ranges are supported")
  }
  const spec = t.substring(6, t.length() - 6)
  const dash = spec.index_of("-")
  if dash < 0 {
    return (R.error, "a range needs a dash")
  }
  const start_text = spec.substring(0, dash)
  const end_text = spec.substring(dash + 1, spec.length() - dash - 1)
  if start_text == "" {
    return (R.error, "suffix ranges are not supported")
  }
  const start = start_text.to_int64()
  if start < 0 {
    return (R.error, "the range start must be a number")
  }
  var end = start + blob_range_window - 1
  if end_text != "" {
    const requested = end_text.to_int64()
    if requested < start {
      return (R.error, "the range end precedes its start")
    }
    if requested < end {
      end = requested
    }
  }
  return (R.ok, (start, end))
}

// The window's body from the store's range read; out-of-window starts and
// zero-length windows are the RFC's 416.
def ranged_response(store registry.blobstore.BlobStore, digest String, size Int64, window (Int64, Int64)) httpd.Response {
  const start = window[0]
  const end = window[1]
  if start < 0 {
    return full_response(store, digest)
  }
  if start >= size {
    return httpd.response(416, [("Content-Range", "bytes */" + size.to_string())], "")
  }
  var stop = end
  if stop >= size {
    stop = size - 1
  }
  const length = stop - start + 1
  case store.read_range(digest, start, length) {
    (R.error, why) then {
      if registry.blobstore.is_not_found(why) {
        return registry.api.not_found(registry.api.code_blob_unknown, "blob unknown", digest)
      }
      return registry.api.server_error("blob read failed", why)
    }
    (R.ok, body) then {
      return httpd.response(206, registry.cache.with_cache([
        ("Content-Type", content_type),
        ("Docker-Content-Digest", digest),
        ("Content-Length", body.to_bytes().length().to_string()),
        ("Content-Range", "bytes " + start.to_string() + "-" + stop.to_string() + "/" + size.to_string())
      ], registry.cache.blob_headers(digest)), body)
    }
  }
}

def full_response(store registry.blobstore.BlobStore, digest String) httpd.Response {
  case store.get(digest) {
    (R.error, why) then {
      if registry.blobstore.is_not_found(why) {
        return registry.api.not_found(registry.api.code_blob_unknown, "blob unknown", digest)
      }
      return registry.api.server_error("blob read failed", why)
    }
    (R.ok, body) then {
      return httpd.response(200, registry.cache.with_cache([
        ("Content-Type", content_type),
        ("Docker-Content-Digest", digest),
        ("Content-Length", body.to_bytes().length().to_string())
      ], registry.cache.blob_headers(digest)), body)
    }
  }
}

def size_of(store_size Int64, link_size Int64) Int64 {
  if store_size >= 0 {
    return store_size
  }
  return link_size
}

def head_response(digest String, size Int64) httpd.Response {
  var headers = registry.cache.with_cache([
    ("Content-Type", content_type),
    ("Docker-Content-Digest", digest)
  ], registry.cache.blob_headers(digest))
  if size >= 0 {
    headers = headers.append(("Content-Length", size.to_string()))
  }
  return httpd.response(200, headers, "")
}

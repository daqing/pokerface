// ---------------------------------------------------------------------------
// DELETE: cancel.

def test_delete_cancels_and_disables_the_session() {
  const sessions = FakeSessions.new()
  const store = FakeStore.new()
  const id = open_session(sessions, store)
  const patched = patch_chunk(sessions, id, "hel", "")
  expect_equal(202, patched.status)
  const deleted = uploads.handle(make_request("DELETE", "/v2/acme/app/blobs/uploads/" + id), sessions, store)
  expect_equal(204, deleted.status)
  expect_equal("", deleted.body)
  case sessions.lookup(id) {
    (R.ok, session) then { expect_equal(state_cancelled, session.state) }
    (R.error, _) then { expect_true(false) }
  }
  const patched_again = patch_chunk(sessions, id, "more", "")
  expect_equal(404, patched_again.status)
  const get = uploads.handle(make_request("GET", "/v2/acme/app/blobs/uploads/" + id), sessions, store)
  expect_equal(404, get.status)
  const put = uploads.handle(make_request_body("PUT", "/v2/acme/app/blobs/uploads/" + id, digest_query(hello_digest()), "hello"), sessions, store)
  expect_equal(404, put.status)
  const again = uploads.handle(make_request("DELETE", "/v2/acme/app/blobs/uploads/" + id), sessions, store)
  expect_equal(404, again.status)
}


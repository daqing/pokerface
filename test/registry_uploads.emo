// ---------------------------------------------------------------------------
// Full chunked flows against the real LocalStore with real part files.

def test_multi_patch_then_put_stores_the_chunks_in_order() {
  case blobstore.open(tmp_root("chunked-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("chunked-parts"))
      const id = open_session(sessions, store)
      const first = uploads.handle(ranged_request("PATCH", "/v2/acme/app/blobs/uploads/" + id, Map.new(), "hello ", "0-5"), sessions, store)
      expect_equal(202, first.status)
      expect_equal("0-5", header_value(first.headers, "range"))
      const second = uploads.handle(ranged_request("PATCH", "/v2/acme/app/blobs/uploads/" + id, Map.new(), "world", "6-10"), sessions, store)
      expect_equal(202, second.status)
      expect_equal("0-10", header_value(second.headers, "range"))
      const done = uploads.handle(make_request_body("PUT", "/v2/acme/app/blobs/uploads/" + id, digest_query(sha256_digest("hello world")), ""), sessions, store)
      expect_equal(201, done.status)
      case store.get(sha256_digest("hello world")) {
        (R.error, why) then { expect_true(false) }
        (R.ok, body) then { expect_equal("hello world", body) }
      }
    }
  }
}

def test_the_final_chunk_may_ride_the_put() {
  case blobstore.open(tmp_root("final-chunk-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("final-chunk-parts"))
      const id = open_session(sessions, store)
      const patched = uploads.handle(ranged_request("PATCH", "/v2/acme/app/blobs/uploads/" + id, Map.new(), "hel", "0-2"), sessions, store)
      expect_equal(202, patched.status)
      const done = uploads.handle(ranged_request("PUT", "/v2/acme/app/blobs/uploads/" + id, digest_query(hello_digest()), "lo", "3-4"), sessions, store)
      expect_equal(201, done.status)
      case store.get(hello_digest()) {
        (R.error, why) then { expect_true(false) }
        (R.ok, body) then { expect_equal("hello", body) }
      }
    }
  }
}

def test_streamed_patch_then_put_the_skopeo_shape() {
  case blobstore.open(tmp_root("streamed-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("streamed-parts"))
      const id = open_session(sessions, store)
      const patched = patch_chunk(sessions, id, "hello world", "")
      expect_equal(202, patched.status)
      expect_equal("0-10", header_value(patched.headers, "range"))

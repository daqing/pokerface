// PATCH: chunks.

def test_patch_appends_a_streaming_chunk() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const response = patch_chunk(sessions, id, "hel", "")
  expect_equal(202, response.status)
  expect_equal("/v2/acme/app/blobs/uploads/" + id, header_value(response.headers, "location"))
  expect_equal(id, header_value(response.headers, "docker-upload-uuid"))
  expect_equal("0-2", header_value(response.headers, "range"))
  case sessions.lookup(id) {
    (R.ok, session) then { expect_equal(3, session.offset) }
    (R.error, _) then { expect_true(false) }
  }
}

def test_patch_with_a_matching_content_range() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const response = patch_chunk(sessions, id, "hel", "0-2")
  expect_equal(202, response.status)
  expect_equal("0-2", header_value(response.headers, "range"))
  const second = patch_chunk(sessions, id, "lo", "3-4")
  expect_equal(202, second.status)
  expect_equal("0-4", header_value(second.headers, "range"))
  case sessions.lookup(id) {
    (R.ok, session) then { expect_equal(5, session.offset) }
    (R.error, _) then { expect_true(false) }
  }
}

def test_patch_out_of_order_is_a_416() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const first = patch_chunk(sessions, id, "hel", "0-2")
  expect_equal(202, first.status)
  const second = patch_chunk(sessions, id, "hel", "0-2")
  expect_equal(416, second.status)
  expect_equal(api.code_blob_upload_invalid, error_field(second.body, "code"))
  expect_true(error_field(second.body, "detail").index_of("offset mismatch") >= 0)
  case sessions.lookup(id) {
    (R.ok, session) then {
      expect_equal(3, session.offset)
      expect_equal(state_pending, session.state)
    }
    (R.error, _) then { expect_true(false) }
  }
}

def test_patch_gap_is_a_416() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const response = patch_chunk(sessions, id, "hello", "1-5")
  expect_equal(416, response.status)
  expect_equal(api.code_blob_upload_invalid, error_field(response.body, "code"))
}

def test_patch_content_range_disagreeing_with_the_body_is_a_400() {

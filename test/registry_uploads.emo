  case sessions.lookup(id) {
    (R.ok, session) then { expect_equal(0, session.offset) }
    (R.error, _) then { expect_true(false) }
  }
}

def test_patch_content_range_end_before_start_is_a_400() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const response = patch_chunk(sessions, id, "hel", "5-4")
  expect_equal(400, response.status)
  expect_equal(api.code_blob_upload_invalid, error_field(response.body, "code"))
}

def test_patch_malformed_content_ranges_are_400s() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const bytes_form = patch_chunk(sessions, id, "hel", "bytes=0-2")
  expect_equal(400, bytes_form.status)
  const words = patch_chunk(sessions, id, "hel", "abc")
  expect_equal(400, words.status)
  const open_end = patch_chunk(sessions, id, "hel", "5-")
  expect_equal(400, open_end.status)
  const triple = patch_chunk(sessions, id, "hel", "0-2-4")
  expect_equal(400, triple.status)
  case sessions.lookup(id) {
    (R.ok, session) then { expect_equal(0, session.offset) }
    (R.error, _) then { expect_true(false) }
  }
}


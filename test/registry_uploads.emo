// Dedup (fake store and the real LocalStore).

def test_duplicate_uploads_store_one_copy() {
  const sessions = FakeSessions.new()
  const store = FakeStore.new()
  const first = upload_body(sessions, store, "hello", hello_digest())
  expect_equal(201, first.status)
  const second = upload_body(sessions, store, "hello", hello_digest())
  expect_equal(201, second.status)
  expect_equal(2, store.put_file_count())
  expect_equal(1, store.store_count())
}

def test_duplicate_blobs_are_stored_once_in_the_local_store() {
  case blobstore.open(tmp_root("dedup")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("dedup-parts"))
      const first = upload_body(sessions, store, "hello", hello_digest())
      expect_equal(201, first.status)
      const second = upload_body(sessions, store, "hello", hello_digest())
      expect_equal(201, second.status)
      case store.head(hello_digest()) {
        (R.error, why) then { expect_true(false) }
        (R.ok, info) then {
          expect_true(info.exists)
          expect_equal(5, info.size)
        }
      }
      case os.list_dir(store.dir()) {
        (R.error, why) then { expect_true(false) }
        (R.ok, entries) then { expect_equal(2, entries.length()) }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Methods and paths.

def test_the_collection_serves_post_only() {
  const sessions = FakeSessions.new()
  const path = "/v2/acme/app/blobs/uploads/"
  const get = uploads.handle(make_request("GET", path), sessions, FakeStore.new())
  expect_equal(405, get.status)
  expect_equal("POST", header_value(get.headers, "allow"))
  const put = uploads.handle(make_request("PUT", path), sessions, FakeStore.new())
  expect_equal(405, put.status)
  expect_equal("POST", header_value(put.headers, "allow"))
}

def test_the_item_serves_the_upload_methods_only() {
  const sessions = FakeSessions.new()
  const id = open_session(sessions, FakeStore.new())
  const path = "/v2/acme/app/blobs/uploads/" + id
  const post = uploads.handle(make_request("POST", path), sessions, FakeStore.new())
  expect_equal(405, post.status)
  expect_equal("GET, PATCH, PUT, DELETE", header_value(post.headers, "allow"))
  const head = uploads.handle(make_request("HEAD", path), sessions, FakeStore.new())
  expect_equal(405, head.status)
}

def test_unrouted_upload_paths_fall_through_to_the_catch_all() {
  const response = uploads.handle(make_request("POST", "/v2/acme/app/blobs/uploads/a/b"), FakeSessions.new(), FakeStore.new())
  expect_equal(404, response.status)
}

def test_path_shapes() {
  expect_true(uploads.is_route("/v2/acme/app/blobs/uploads/"))
  expect_true(uploads.is_route("/v2/acme/app/blobs/uploads/sess-1"))
  expect_true(!uploads.is_route("/v2/acme/app/blobs/sha256:abcdef"))
  expect_true(!uploads.is_route("/v2/acme/app/manifests/latest"))
  const collection = uploads.split("/v2/acme/team/app/blobs/uploads/")
  expect_equal("acme/team/app", collection[0])
  expect_equal("collection", collection[1])
  expect_equal("", collection[2])
  const item = uploads.split("/v2/acme/app/blobs/uploads/sess-1")
  expect_equal("acme/app", item[0])
  expect_equal("item", item[1])
  expect_equal("sess-1", item[2])
  expect_equal("", uploads.split("/v2/acme/app/blobs/uploads/a/b")[0])
  expect_equal("", uploads.split("/v2/acme/app/blobs/")[0])
}

// ---------------------------------------------------------------------------
// Content-Range parsing.

def test_content_range_parsing() {
  case uploads.parse_content_range("") {
    (R.ok, range) then {
      expect_true(!range.ranged)
      expect_equal(0, range.start)
      expect_equal(0, range.end)
    }
    (R.error, _) then { expect_true(false) }
  }
  case uploads.parse_content_range("0-99") {
    (R.ok, range) then {
      expect_true(range.ranged)
      expect_equal(0, range.start)
      expect_equal(99, range.end)
    }
    (R.error, _) then { expect_true(false) }
  }
  case uploads.parse_content_range("bytes=0-99") {
    (R.error, _) then { expect_true(true) }
    (R.ok, _) then { expect_true(false) }
  }
  case uploads.parse_content_range("-5") {
    (R.error, _) then { expect_true(true) }
    (R.ok, _) then { expect_true(false) }
  }
  case uploads.parse_content_range("5-") {
    (R.error, _) then { expect_true(true) }
    (R.ok, _) then { expect_true(false) }
  }
  case uploads.parse_content_range("a-b") {
    (R.error, _) then { expect_true(true) }
    (R.ok, _) then { expect_true(false) }
  }
}

// ---------------------------------------------------------------------------
// Repository name grammar.

def test_valid_repository_names() {
  expect_true(uploads.valid_name("acme/app"))
  expect_true(uploads.valid_name("a"))
  expect_true(uploads.valid_name("a.b"))
  expect_true(uploads.valid_name("a_b"))
  expect_true(uploads.valid_name("a__b"))
  expect_true(uploads.valid_name("a-b"))
  expect_true(uploads.valid_name("a--b"))
  expect_true(uploads.valid_name("acme/team-1/app_name.v2"))
}

def test_invalid_repository_names() {
  expect_true(!uploads.valid_name(""))
  expect_true(!uploads.valid_name("Acme"))
  expect_true(!uploads.valid_name("a___b"))
  expect_true(!uploads.valid_name("a..b"))
  expect_true(!uploads.valid_name("a.-b"))
  expect_true(!uploads.valid_name("a-"))
  expect_true(!uploads.valid_name("-a"))
  expect_true(!uploads.valid_name(".a"))
  expect_true(!uploads.valid_name("a_b_"))
  expect_true(!uploads.valid_name("a/"))
  expect_true(!uploads.valid_name("/a"))
  expect_true(!uploads.valid_name("a//b"))
  expect_true(!uploads.valid_name("a b"))
  expect_true(!uploads.valid_name(long_name()))
}

def long_name() String {
  var out = "a"
  var i = 0
  while i < 256 {
    out = out + "b"
    i = i + 1
  }
  return out
}

// ---------------------------------------------------------------------------
// Router dispatch.

def test_the_router_dispatches_the_upload_methods() {
  case blobstore.open(tmp_root("router-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const config = registry.config.RegistryConfig.new(
        registry.config.RegistryListen.new("127.0.0.1", 5000),
        "/tmp/pf-uploads-router",
        "/tmp/pf-uploads-router/registry.db",
        registry.config.RegistryStore.new("fs", "/tmp/pf-uploads-router/blobs", registry.config.default_s3()),
        registry.config.RegistryLimits.new(16777216, 1048576, 30, 5),
        "/tmp/pf-uploads-router/shutdown",
        "<test>",
    registry.config.default_auth(),
    registry.config.ObservabilityConfig.new(false, false))
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("router-parts"))
      const links = UploadFakeLinks.new()
      const service = registry.router.Service.new(
        config,
        UploadFakeDb.new(),
        UploadFakeHealth.new(),
        store,
        links,
        UploadFakeManifests.new(),
        sessions,
        UploadFakeWriter.new(),
    UploadFakeTags.new(),
    UploadFakeMetricsSink.new())
      const opened = registry.router.handle(make_request("POST", "/v2/acme/app/blobs/uploads/"), service)
      expect_equal(202, opened.status)
      expect_equal("registry/2.0", header_value(opened.headers, "docker-distribution-api-version"))
      expect_true(header_value(opened.headers, "x-request-id") != "")
      const id = header_value(opened.headers, "docker-upload-uuid")
      const path = "/v2/acme/app/blobs/uploads/" + id
      const patched = registry.router.handle(make_request_body("PATCH", path, Map.new(), "hello"), service)
      expect_equal(202, patched.status)
      expect_equal("0-4", header_value(patched.headers, "range"))
      const status = registry.router.handle(make_request("GET", path), service)
      expect_equal(204, status.status)
      const done = registry.router.handle(make_request_body("PUT", path, digest_query(hello_digest()), ""), service)
      expect_equal(201, done.status)
      // The blob GET route answers through the same service, now linked.
      links.found.replace(true)
      const fetched = registry.router.handle(make_request("GET", "/v2/acme/app/blobs/" + hello_digest()), service)
      expect_equal(200, fetched.status)
      expect_equal("hello", fetched.body)
    }
  }
}

class UploadFakeDb {
  def init() {
  }

  def ping() Bool {
    return true
  }

  def path() String {
    return "/tmp/fake.db"
  }
}

class UploadFakeHealth {
  def init() {
  }

  def probe() (R, String) {
    return (R.ok, "fs:/tmp/fake")
  }
}

class UploadFakeLinks {
  def init() {
    self.found = Box.new(false)
  }

  def linked(repository String, digest String) (R, registry.blobs.BlobLink) {
    return (R.ok, registry.blobs.BlobLink.new(self.found.read(), 5))
  }
}

class UploadFakeManifests {
  def init() {
  }

  def lookup(repository String, reference String) (R, registry.manifests.ManifestPayload) {
    return (R.ok, registry.manifests.absent_payload())
  }
}

class UploadFakeWriter {
  def init() {
  }

  def put(repository String, media_type String, body String) (R, String) {
    return (R.ok, "sha256:1111111111111111111111111111111111111111111111111111111111111111")
  }

  def tag(repository String, tag String, digest String) (R, Bool) {
    return (R.ok, true)
  }
}

class UploadFakeTags {
  def init() {
  }

  def page(repository String, last String, limit Int64) (R, registry.tags.TagPage) {
    return (R.ok, registry.tags.TagPage.new(true, [], false))
  }
}

class UploadFakeMetricsSink {
  def init() {
  }

  def record(stats registry.metrics.RequestStats) Void {
  }

  def render() String {
    return "# TYPE pokerface_requests_total counter\npokerface_requests_total 0\n"
  }
}

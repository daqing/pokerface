      expect_equal(201, done.status)
      case store.get(sha256_digest("hello world")) {
        (R.error, why) then { expect_true(false) }
        (R.ok, body) then { expect_equal("hello world", body) }
      }
    }
  }
}

def test_put_out_of_order_final_chunk_is_a_416() {
  case blobstore.open(tmp_root("final-mis-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("final-mis-parts"))
      const id = open_session(sessions, store)
      const patched = uploads.handle(ranged_request("PATCH", "/v2/acme/app/blobs/uploads/" + id, Map.new(), "hel", "0-2"), sessions, store)
      expect_equal(202, patched.status)
      const done = uploads.handle(ranged_request("PUT", "/v2/acme/app/blobs/uploads/" + id, digest_query(hello_digest()), "lo", "0-1"), sessions, store)
      expect_equal(416, done.status)
      expect_equal(api.code_blob_upload_invalid, error_field(done.body, "code"))
    }
  }
}

def test_put_digest_mismatch_keeps_the_session_and_its_data() {
  case blobstore.open(tmp_root("mismatch-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("mismatch-parts"))
      const id = open_session(sessions, store)
      const patched = patch_chunk(sessions, id, "hello", "")
      expect_equal(202, patched.status)
      const done = uploads.handle(make_request_body("PUT", "/v2/acme/app/blobs/uploads/" + id, digest_query(sha256_digest("world")), ""), sessions, store)
      expect_equal(400, done.status)
      expect_equal(api.code_digest_invalid, error_field(done.body, "code"))
      // The session survives with its data, so the client can inspect and
      // restart; nothing entered the blob store.
      const get = uploads.handle(make_request("GET", "/v2/acme/app/blobs/uploads/" + id), sessions, store)
      expect_equal(204, get.status)
      expect_equal("0-4", header_value(get.headers, "range"))
      case store.head(sha256_digest("world")) {
        (R.ok, info) then { expect_true(!info.exists) }
        (R.error, _) then { expect_true(false) }
      }
      const deleted = uploads.handle(make_request("DELETE", "/v2/acme/app/blobs/uploads/" + id), sessions, store)
      expect_equal(204, deleted.status)
    }
  }
}

def test_an_empty_blob_uploads_through_the_chunked_path() {
  case blobstore.open(tmp_root("empty-chunk-store")) {
    (R.error, why) then { expect_true(false) }
    (R.ok, store) then {
      const sessions = FakeSessions.new()
      sessions.use_files(tmp_root("empty-chunk-parts"))
      const id = open_session(sessions, store)
      const done = uploads.handle(make_request_body("PUT", "/v2/acme/app/blobs/uploads/" + id, digest_query(sha256_digest("")), ""), sessions, store)
      expect_equal(201, done.status)
      case store.head(sha256_digest("")) {
        (R.error, why) then { expect_true(false) }
        (R.ok, info) then {
          expect_true(info.exists)
          expect_equal(0, info.size)
        }
      }
    }
  }
}


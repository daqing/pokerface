// T2.1 tests for the registry configuration — run with `emo test`.

const reg_config = registry.config

require "file"

def reg_tmp_base() String {
  var base = "/tmp/"
  case os.getenv("TMPDIR") {
    (R.ok, tmp) then {
      if tmp != "" {
        base = tmp
      }
    }
    (R.error, _) then { base = "/tmp/" }
  }
  if base.substring(base.length() - 1, 1) != "/" {
    base = base + "/"
  }
  return base
}

def reg_tmp(name String) String {
  return reg_tmp_base() + "pokerface-registry-cfg-" + os.getpid().to_string() + "-" + name
}

def write_config(path String, text String) {
  case file.write(path, text) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail("cannot write " + path + ": " + why) }
  }
}

class RegFakeEnv {
  def init(values Map[String, String]) {
    self.values = values
  }

  def getenv(name String) (R, String) {
    if self.values.has(name) {
      return (R.ok, self.values.get(name))
    }
    return (R.error, "os: getenv " + name + ": is not set")
  }
}

def env_empty() RegFakeEnv {
  return RegFakeEnv.new(Map.new())
}

def full_config() String {
  return (
    "listen:\n"
    + "  host: 127.0.0.1\n"
    + "  port: 5100\n"
    + "data_dir: /tmp/reg-data\n"
    + "db_path: /tmp/reg-data/custom.db\n"
    + "store:\n"
    + "  backend: fs\n"
    + "  root: /tmp/reg-blobs\n"
    + "limits:\n"
    + "  max_body_bytes: 2048\n"
    + "  max_header_bytes: 1024\n"
    + "  read_timeout: 10\n"
    + "  idle_timeout: 2\n"
    + "shutdown_file: /tmp/reg-stop\n"
  )
}

def expect_config_ok(result (R, registry.config.RegistryConfig), label String) registry.config.RegistryConfig {
  case result {
    (R.ok, config) then { return config }
    (R.error, why) then {
      expect_fail(label + " failed: " + why)
      return registry.config.RegistryConfig.new(
        registry.config.RegistryListen.new("", 0),
        "",
        "",
        registry.config.RegistryStore.new("", "", registry.config.default_s3()),
        registry.config.RegistryLimits.new(0, 0, 0, 0),
        "",
        "",
    registry.config.default_auth(),
    registry.config.default_observability())
    }
  }
}

def test_full_config_parses() {
  const path = reg_tmp("full.yaml")
  write_config(path, full_config())
  const config = expect_config_ok(reg_config.load(env_empty(), path), "load")
  expect_equal("127.0.0.1", config.listen.host)
  expect_equal(5100, config.listen.port)
  expect_equal("/tmp/reg-data", config.data_dir)
  expect_equal("/tmp/reg-data/custom.db", config.db_path)
  expect_equal("fs", config.store.backend)
  expect_equal("/tmp/reg-blobs", config.store.root)
  expect_equal(2048, config.limits.max_body_bytes)
  expect_equal(1024, config.limits.max_header_bytes)
  expect_equal(10, config.limits.read_timeout)
  expect_equal(2, config.limits.idle_timeout)
  expect_equal("/tmp/reg-stop", config.shutdown_file)
  expect_equal(path, config.config_path)
}

def test_defaults_apply_to_an_empty_mapping() {
  const path = reg_tmp("empty.yaml")
  write_config(path, "{}\n")
  const config = expect_config_ok(reg_config.load(env_empty(), path), "load")
  expect_equal("127.0.0.1", config.listen.host)
  expect_equal(5000, config.listen.port)
  expect_equal("./data", config.data_dir)
  expect_equal("./data/registry.db", config.db_path)
  expect_equal("fs", config.store.backend)
  expect_equal("./data/blobs", config.store.root)
  expect_equal(16777216, config.limits.max_body_bytes)
  expect_equal("./data/registry.shutdown", config.shutdown_file)
}

def test_missing_config_is_a_clear_error() {
  const path = reg_tmp("missing.yaml")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a missing-config error") }
    (R.error, why) then {
      expect_true(why.index_of("config " + path + " not found") >= 0)
      expect_true(why.index_of("--config") >= 0)
    }
  }
}

def test_env_path_is_used_when_no_flag() {
  const path = reg_tmp("envpath.yaml")
  write_config(path, full_config())
  const env = RegFakeEnv.new(Map.new(("POKERFACE_REGISTRY_CONFIG", path)))
  const config = expect_config_ok(reg_config.load(env, ""), "load")
  expect_equal(5100, config.listen.port)
  expect_equal(path, config.config_path)
}

def test_flag_path_wins_over_env_path() {
  const flag = reg_tmp("flagwin.yaml")
  const env_path = reg_tmp("envlose.yaml")
  write_config(flag, full_config())
  write_config(env_path, "listen:\n  port: 5999\n")
  const env = RegFakeEnv.new(Map.new(("POKERFACE_REGISTRY_CONFIG", env_path)))
  const config = expect_config_ok(reg_config.load(env, flag), "load")
  expect_equal(5100, config.listen.port)
}

def test_env_overrides_file_values() {
  const path = reg_tmp("envover.yaml")
  write_config(path, full_config())
  const env = RegFakeEnv.new(Map.new(
    ("POKERFACE_REGISTRY_LISTEN", "0.0.0.0:6000"),
    ("POKERFACE_REGISTRY_DATA_DIR", "/tmp/env-data"),
    ("POKERFACE_REGISTRY_DB_PATH", "/tmp/env-data/env.db"),
    ("POKERFACE_REGISTRY_STORE_BACKEND", "s3"),
    ("POKERFACE_REGISTRY_STORE_ROOT", "bucket/key"),
    ("POKERFACE_REGISTRY_S3_ENDPOINT", "http://127.0.0.1:9000"),
    ("POKERFACE_REGISTRY_S3_BUCKET", "bucket"),
    ("POKERFACE_REGISTRY_S3_ACCESS_KEY", "AK"),
    ("POKERFACE_REGISTRY_S3_SECRET_KEY", "SK"),
    ("POKERFACE_REGISTRY_MAX_BODY_BYTES", "4096"),
    ("POKERFACE_REGISTRY_MAX_HEADER_BYTES", "2048"),
    ("POKERFACE_REGISTRY_READ_TIMEOUT", "7"),
    ("POKERFACE_REGISTRY_IDLE_TIMEOUT", "3"),
    ("POKERFACE_REGISTRY_SHUTDOWN_FILE", "/tmp/env-stop")
  ))
  const config = expect_config_ok(reg_config.load(env, path), "load")
  expect_equal("0.0.0.0", config.listen.host)
  expect_equal(6000, config.listen.port)
  expect_equal("/tmp/env-data", config.data_dir)
  expect_equal("/tmp/env-data/env.db", config.db_path)
  expect_equal("s3", config.store.backend)
  expect_equal("bucket/key", config.store.root)
  expect_equal(4096, config.limits.max_body_bytes)
  expect_equal(2048, config.limits.max_header_bytes)
  expect_equal(7, config.limits.read_timeout)
  expect_equal(3, config.limits.idle_timeout)
  expect_equal("/tmp/env-stop", config.shutdown_file)
}

def test_unknown_fields_are_rejected() {
  const path = reg_tmp("unknown.yaml")
  write_config(path, "bogus: 1\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected an unknown-field error") }
    (R.error, why) then { expect_true(why.index_of("bogus: unknown field") >= 0) }
  }
  write_config(path, "listen:\n  bogus: 1\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a nested unknown-field error") }
    (R.error, why) then { expect_true(why.index_of("listen.bogus: unknown field") >= 0) }
  }
}

def test_invalid_values_are_rejected() {
  const path = reg_tmp("invalid.yaml")
  write_config(path, "listen:\n  port: 70000\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a port error") }
    (R.error, why) then { expect_true(why.index_of("between 0 and 65535") >= 0) }
  }
  write_config(path, "store:\n  backend: nope\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a backend error") }
    (R.error, why) then { expect_true(why.index_of("unknown backend 'nope'") >= 0) }
  }
  write_config(path, "limits:\n  max_body_bytes: 0\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a limit error") }
    (R.error, why) then { expect_true(why.index_of("max_body_bytes: must be positive") >= 0) }
  }
  write_config(path, "listen:\n  host: \"\"\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a host error") }
    (R.error, why) then { expect_true(why.index_of("listen.host: must not be empty") >= 0) }
  }
}

def test_invalid_env_values_are_rejected() {
  const path = reg_tmp("badenv.yaml")
  write_config(path, "{}\n")
  const bad_listen = RegFakeEnv.new(Map.new(("POKERFACE_REGISTRY_LISTEN", "nope")))
  case reg_config.load(bad_listen, path) {
    (R.ok, _) then { expect_fail("expected a listen error") }
    (R.error, why) then { expect_true(why.index_of("POKERFACE_REGISTRY_LISTEN") >= 0) }
  }
  const bad_int = RegFakeEnv.new(Map.new(("POKERFACE_REGISTRY_MAX_BODY_BYTES", "lots")))
  case reg_config.load(bad_int, path) {
    (R.ok, _) then { expect_fail("expected an integer error") }
    (R.error, why) then { expect_true(why.index_of("POKERFACE_REGISTRY_MAX_BODY_BYTES") >= 0) }
  }
}

def test_summary_contains_the_effective_values() {
  const path = reg_tmp("summary.yaml")
  write_config(path, full_config())
  const config = expect_config_ok(reg_config.load(env_empty(), path), "load")
  const text = reg_config.summary(config)
  expect_true(text.index_of("listen=127.0.0.1:5100") >= 0)
  expect_true(text.index_of("store=fs:/tmp/reg-blobs") >= 0)
  expect_true(text.index_of("db=/tmp/reg-data/custom.db") >= 0)
  expect_true(text.index_of("max_body=2048") >= 0)
  expect_true(text.index_of("shutdown_file=/tmp/reg-stop") >= 0)
}
def s3_config() String {
  return (
    "store:\n"
    + "  backend: s3\n"
    + "  s3:\n"
    + "    endpoint: http://127.0.0.1:9000\n"
    + "    bucket: pokerface\n"
    + "    region: eu-west-1\n"
    + "    access_key: AKIAEXAMPLE\n"
    + "    secret_key: secret-value\n"
    + "    path_style: false\n"
    + "    prefix: /registry/blobs/\n"
    + "    ca_file: /tmp/ca.pem\n"
    + "    verify_tls: false\n"
    + "    presign_ttl: 120\n"
  )
}

def test_s3_config_parses() {
  const path = reg_tmp("s3.yaml")
  write_config(path, s3_config())
  const config = expect_config_ok(reg_config.load(env_empty(), path), "load")
  expect_equal("s3", config.store.backend)
  expect_equal("http://127.0.0.1:9000", config.store.s3.endpoint)
  expect_equal("pokerface", config.store.s3.bucket)
  expect_equal("eu-west-1", config.store.s3.region)
  expect_equal("AKIAEXAMPLE", config.store.s3.access_key)
  expect_equal("secret-value", config.store.s3.secret_key)
  expect_true(!config.store.s3.path_style)
  expect_equal("/registry/blobs/", config.store.s3.prefix)
  expect_equal("/tmp/ca.pem", config.store.s3.ca_file)
  expect_true(!config.store.s3.verify_tls)
  expect_equal(120, config.store.s3.presign_ttl)
}

def test_s3_defaults_apply() {
  const path = reg_tmp("s3-min.yaml")
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: http://minio:9000\n    bucket: b\n    access_key: a\n    secret_key: s\n")
  const config = expect_config_ok(reg_config.load(env_empty(), path), "load")
  expect_equal("us-east-1", config.store.s3.region)
  expect_true(config.store.s3.path_style)
  expect_equal("", config.store.s3.prefix)
  expect_equal("", config.store.s3.ca_file)
  expect_true(config.store.s3.verify_tls)
  expect_equal(900, config.store.s3.presign_ttl)
}

def test_s3_requires_endpoint_bucket_and_credentials() {
  const path = reg_tmp("s3-missing.yaml")
  write_config(path, "store:\n  backend: s3\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected an s3 endpoint error") }
    (R.error, why) then { expect_true(why.index_of("store.s3.endpoint") >= 0) }
  }
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: http://minio:9000\n    bucket: b\n    access_key: a\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a missing secret error") }
    (R.error, why) then { expect_true(why.index_of("store.s3.secret_key") >= 0) }
  }
}

def test_s3_rejects_bad_endpoints_and_ttl() {
  const path = reg_tmp("s3-bad.yaml")
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: minio:9000\n    bucket: b\n    access_key: a\n    secret_key: s\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a scheme error") }
    (R.error, why) then { expect_true(why.index_of("must start with http:// or https://") >= 0) }
  }
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: http://minio:9000/bucket\n    bucket: b\n    access_key: a\n    secret_key: s\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a path error") }
    (R.error, why) then { expect_true(why.index_of("must not include a path") >= 0) }
  }
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: http://minio:9000\n    bucket: b\n    access_key: a\n    secret_key: s\n    presign_ttl: 700000\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a ttl error") }
    (R.error, why) then { expect_true(why.index_of("presign_ttl") >= 0) }
  }
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: http://minio:9000\n    bucket: b\n    access_key: a\n    secret_key: s\n    presign_ttl: -1\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, _) then { expect_fail("expected a negative-ttl error") }
    (R.error, why) then { expect_true(why.index_of("presign_ttl") >= 0) }
  }
  // 0 is the "stream through the registry" switch, not an error.
  write_config(path, "store:\n  backend: s3\n  s3:\n    endpoint: http://minio:9000\n    bucket: b\n    access_key: a\n    secret_key: s\n    presign_ttl: 0\n")
  case reg_config.load(env_empty(), path) {
    (R.ok, config) then { expect_equal(0, config.store.s3.presign_ttl) }
    (R.error, why) then { expect_fail(why) }
  }
}

def test_s3_env_overrides() {
  const path = reg_tmp("s3-env.yaml")
  write_config(path, s3_config())
  const env = RegFakeEnv.new(Map.new(
    ("POKERFACE_REGISTRY_S3_ENDPOINT", "https://s3.example.com"),
    ("POKERFACE_REGISTRY_S3_BUCKET", "other"),
    ("POKERFACE_REGISTRY_S3_ACCESS_KEY", "ENVKEY"),
    ("POKERFACE_REGISTRY_S3_SECRET_KEY", "env-secret"),
    ("POKERFACE_REGISTRY_S3_PATH_STYLE", "true"),
    ("POKERFACE_REGISTRY_S3_PREFIX", "pf"),
    ("POKERFACE_REGISTRY_S3_VERIFY_TLS", "true"),
    ("POKERFACE_REGISTRY_S3_PRESIGN_TTL", "60")
  ))
  const config = expect_config_ok(reg_config.load(env, path), "load")
  expect_equal("https://s3.example.com", config.store.s3.endpoint)
  expect_equal("other", config.store.s3.bucket)
  expect_equal("ENVKEY", config.store.s3.access_key)
  expect_equal("env-secret", config.store.s3.secret_key)
  expect_true(config.store.s3.path_style)
  expect_equal("pf", config.store.s3.prefix)
  expect_true(config.store.s3.verify_tls)
  expect_equal(60, config.store.s3.presign_ttl)
  const bad = RegFakeEnv.new(Map.new(("POKERFACE_REGISTRY_S3_VERIFY_TLS", "maybe")))
  case reg_config.load(bad, path) {
    (R.ok, _) then { expect_fail("expected a bool error") }
    (R.error, why) then { expect_true(why.index_of("POKERFACE_REGISTRY_S3_VERIFY_TLS") >= 0) }
  }
}

def test_s3_summary_redacts_credentials() {
  const path = reg_tmp("s3-summary.yaml")
  write_config(path, s3_config())
  const config = expect_config_ok(reg_config.load(env_empty(), path), "load")
  const text = reg_config.summary(config)
  expect_true(text.index_of("store=s3:http://127.0.0.1:9000/pokerface") >= 0)
  expect_true(text.index_of("access_key=<set>") >= 0)
  expect_true(text.index_of("AKIAEXAMPLE") < 0)
  expect_true(text.index_of("secret-value") < 0)
}

// T2.18 tests for metrics and observability — run with `emo test`.
//
// The counter math and the Prometheus rendering run against the fake-free
// parts; the SQLite bumps live in the compiled db_selftest. The router legs
// pin /metrics as public with auth enabled and the route_kind grouping.

const metrics = registry.metrics

require "httpd"
require "json"

// ---------------------------------------------------------------------------
// Buckets.

def test_bucket_edges() {
  expect_equal("0.005", metrics.bucket_of(5))
  expect_equal("0.005", metrics.bucket_of(0))
  expect_equal("0.010", metrics.bucket_of(6))
  expect_equal("0.100", metrics.bucket_of(100))
  expect_equal("1.000", metrics.bucket_of(1000))
  expect_equal("+Inf", metrics.bucket_of(10001))
}

// ---------------------------------------------------------------------------
// The Prometheus rendering.

// The Prometheus rendering reads a real database, so its counting and
// cumulative-bucket checks live in the compiled db_selftest; the /metrics
// route here pins the endpoint's shape through the sink.

// ---------------------------------------------------------------------------
// The route grouping.

def test_route_kinds() {
  expect_equal("auth", router_route_kind("/token", "GET"))
  expect_equal("upload", router_route_kind("/v2/acme/app/blobs/uploads/", "POST"))
  expect_equal("upload", router_route_kind("/v2/acme/app/blobs/uploads/sess-1", "PATCH"))
  expect_equal("blob", router_route_kind("/v2/acme/app/blobs/sha256:1111111111111111111111111111111111111111111111111111111111111111", "GET"))
  expect_equal("manifest", router_route_kind("/v2/acme/app/manifests/latest", "GET"))
  expect_equal("manifest", router_route_kind("/v2/acme/app/manifests/v1", "PUT"))
  expect_equal("tags", router_route_kind("/v2/acme/app/tags/list", "GET"))
  expect_equal("metadata", router_route_kind("/api/v1/resolve", "GET"))
  expect_equal("health", router_route_kind("/healthz", "GET"))
  expect_equal("health", router_route_kind("/metrics", "GET"))
  expect_equal("other", router_route_kind("/nope", "GET"))
}


// T1.9 tests for the resolve command — run with `emo test`.
//
// Two loader pitfalls shape this file (both emo v0.26.1115-alpha findings):
// 1. A test file must NOT mirror its subject's path (test/commands/resolve.emo
//    beside src/commands/resolve.emo) — E5003 cycle misfire.
// 2. Top-level `const X = src.common.Flags.new(...)` (any cross-module
//    constructor call during module load) also trips E5003. All such values
//    are built inside defs; top level holds only literal consts and defs.

const res = src.commands.resolve

def temp_base_dir() String {
  var base = "/tmp/"
  case os.getenv("TMPDIR") {
    (R.ok, tmp) then {
      if tmp != "" {
        base = tmp
      }
    }
    (R.error, _) then { base = "/tmp/" }
  }
  if base.substring(base.length() - 1, 1) != "/" {
    base = base + "/"
  }
  return base
}

def work_dir(name String) String {
  return temp_base_dir() + "pokerface-resolve-" + os.getpid().to_string() + "-" + name
}

def test_flags() src.common.Flags {
  return src.common.Flags.new("", false, false)
}

def test_flags_json() src.common.Flags {
  return src.common.Flags.new("", false, true)
}

def test_flags_bad_config() src.common.Flags {
  return src.common.Flags.new("/definitely/not/a/config.yaml", false, false)
}

def empty_env() ResolveFakeEnv {
  return ResolveFakeEnv.new(Map.new())
}

class ResolveFakeEnv {
  def init(values Map[String, String]) {
    self.values = values
  }

  def getenv(name String) (R, String) {
    if self.values.has(name) {
      return (R.ok, self.values.get(name))
    }
    return (R.error, "os: getenv " + name + ": is not set")
  }
}

def resolve_runner() src.git.RealRunner {
  return src.git.RealRunner.new()
}

def expect_runner_ok(result (R, String)) {
  case result {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail("fixture git command failed: " + why) }
  }
}

def valid_lock_text(commit String) String {
  return (
    "version: 1\n"
    + "commit: " + commit + "\n"
    + "source: github.com/acme/app\n"
    + "images:\n"
    + "  - image: registry.example.com/acme/app\n"
    + "    tags: [latest, sha-01234567]\n"
    + "    digest: sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n"
    + "    manifest_digest: sha256:fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\n"
    + "    platforms: [linux/amd64]\n"
    + "    builder: buildkit\n"
  )
}

// Builds a work repo whose HEAD carries a valid lock and pushes it to a bare
// origin; answers (origin, head). The lock's commit field carries the *first*
// commit's SHA (a plain second commit avoids the amend fixed-point problem —
// the field is metadata; resolve reads the lock at whatever commit HEAD is).
def make_origin(name String) (String, String) {
  const work = work_dir(name)
  const origin = work_dir(name + "-origin")
  expect_runner_ok(resolve_runner().run(["git", "init", "-b", "main", work + "/repo"], 10.0))
  const first = commit_with_lock(work + "/repo", valid_lock_text("0000000000000000000000000000000000000000"))
  const fixed = valid_lock_text(first)
  case file.write(work + "/repo/pokerface.lock.yaml", fixed) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail("lock rewrite failed: " + why) }
  }
  expect_runner_ok(resolve_runner().run(["git", "-C", work + "/repo", "add", "pokerface.lock.yaml"], 10.0))
  expect_runner_ok(resolve_runner().run(["git", "-C", work + "/repo", "-c", "user.name=pf", "-c", "user.email=pf@example.com", "commit", "-m", "fix commit field"], 10.0))
  const final_head = head_of(work + "/repo")
  expect_runner_ok(resolve_runner().run(["git", "init", "--bare", origin], 10.0))
  expect_runner_ok(resolve_runner().run(["git", "-C", work + "/repo", "push", origin, "main"], 10.0))
  return (origin, final_head)
}

def commit_with_lock(repo String, lock_text String) String {
  case file.write(repo + "/pokerface.lock.yaml", lock_text) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail("lock write failed: " + why) }
  }
  expect_runner_ok(resolve_runner().run(["git", "-C", repo, "add", "pokerface.lock.yaml"], 10.0))
  expect_runner_ok(resolve_runner().run(["git", "-C", repo, "-c", "user.name=pf", "-c", "user.email=pf@example.com", "commit", "--allow-empty", "-m", "c"], 10.0))
  return head_of(repo)
}

def head_of(repo String) String {
  case resolve_runner().run(["git", "-C", repo, "rev-parse", "HEAD"], 10.0) {
    (R.ok, out) then { return out.trim() }
    (R.error, why) then {
      expect_fail("rev-parse failed: " + why)
      return ""
    }
  }
}

def test_missing_argument_is_usage() {
  expect_equal(src.common.exit_usage, res.run(test_flags(), [], empty_env()))
}

def test_extra_arguments_are_usage() {
  expect_equal(src.common.exit_usage, res.run(test_flags(), ["a", "b"], empty_env()))
}

def test_invalid_reference_is_usage() {
  expect_equal(src.common.exit_usage, res.run(test_flags(), ["not-a-reference"], empty_env()))
}

def test_resolve_end_to_end() {
  const pair = make_origin("e2e")
  const (origin, head) = pair
  const cache = work_dir("e2e-cache")
  const env = ResolveFakeEnv.new(Map.new(("POKERFACE_CACHE_DIR", cache)))
  expect_equal(src.common.exit_ok, res.run(test_flags(), [origin + ":main"], env))
  expect_equal(src.common.exit_ok, res.run(test_flags_json(), [origin + ":main"], env))
  expect_equal(src.common.exit_ok, res.run(test_flags(), [origin], env))
}

def test_resolve_bad_ref_is_git_error() {
  const pair = make_origin("badref")
  const (origin, head) = pair
  const cache = work_dir("badref-cache")
  const env = ResolveFakeEnv.new(Map.new(("POKERFACE_CACHE_DIR", cache)))
  expect_equal(src.common.exit_git, res.run(test_flags(), [origin + ":no-such-ref"], env))
}

def test_config_error_beats_git() {
  const pair = make_origin("cfgerr")
  const (origin, head) = pair
  expect_equal(src.common.exit_metadata, res.run(test_flags_bad_config(), [origin + ":main"], empty_env()))
}

def test_lock_without_manifest_digest_serves_index_digest() {
  const work = work_dir("plaindigest")
  const origin = work_dir("plaindigest-origin")
  expect_runner_ok(resolve_runner().run(["git", "init", "-b", "main", work + "/repo"], 10.0))
  const first = commit_with_lock(work + "/repo", plain_lock_text())
  const fixed = replace_commit_line(plain_lock_text(), first)
  case file.write(work + "/repo/pokerface.lock.yaml", fixed) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail("lock rewrite failed: " + why) }
  }
  expect_runner_ok(resolve_runner().run(["git", "-C", work + "/repo", "add", "pokerface.lock.yaml"], 10.0))
  expect_runner_ok(resolve_runner().run(["git", "-C", work + "/repo", "-c", "user.name=pf", "-c", "user.email=pf@example.com", "commit", "-m", "fix commit field"], 10.0))
  expect_runner_ok(resolve_runner().run(["git", "init", "--bare", origin], 10.0))
  expect_runner_ok(resolve_runner().run(["git", "-C", work + "/repo", "push", origin, "main"], 10.0))
  const cache = work_dir("plaindigest-cache")
  const env = ResolveFakeEnv.new(Map.new(("POKERFACE_CACHE_DIR", cache)))
  expect_equal(src.common.exit_ok, res.run(test_flags(), [origin + ":main"], env))
}

def replace_commit_line(text String, commit String) String {
  const lines = text.split("\n")
  var out = ""
  var i = 0
  while i < lines.length() {
    if lines[i].starts_with("commit: ") {
      out = out + "commit: \"" + commit + "\"\n"
    } else {
      if lines[i] != "" {
        out = out + lines[i] + "\n"
      }
    }
    i = i + 1
  }
  return out
}

def plain_lock_text() String {
  return (
    "version: 1\n"
    + "commit: \"0000000000000000000000000000000000000000\"\n"
    + "source: github.com/acme/app\n"
    + "images:\n"
    + "  - image: registry.example.com/acme/app\n"
    + "    tags: [latest]\n"
    + "    digest: sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n"
  )
}

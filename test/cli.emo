// Tests for src/cli.emo — run them with `emo test`.

const cli = src.cli


def test_exit_code_constants() {
  expect_equal(0, cli.exit_ok)
  expect_equal(1, cli.exit_failure)
  expect_equal(2, cli.exit_usage)
  expect_equal(3, cli.exit_git)
  expect_equal(4, cli.exit_metadata)
  expect_equal(5, cli.exit_auth)
  expect_equal(6, cli.exit_network)
  expect_equal(7, cli.exit_integrity)
  expect_equal(8, cli.exit_runtime)
}

def test_help_flag_exits_zero() {
  expect_equal(cli.exit_ok, cli.route(["pokerface", "--help"]))
}

def test_short_help_flag_exits_zero() {
  expect_equal(cli.exit_ok, cli.route(["pokerface", "-h"]))
}

def test_version_exits_zero() {
  expect_equal(cli.exit_ok, cli.route(["pokerface", "version"]))
}

def test_version_json_flag_exits_zero() {
  expect_equal(cli.exit_ok, cli.route(["pokerface", "version", "--json"]))
}

def test_version_verbose_and_config_flags_exits_zero() {
  expect_equal(cli.exit_ok, cli.route(["pokerface", "--verbose", "--config", "/tmp/f.yaml", "version"]))
}

def test_config_equals_form_exits_zero() {
  expect_equal(cli.exit_ok, cli.route(["pokerface", "--config=/tmp/f.yaml", "version"]))
}

def test_no_arguments_is_usage_error() {
  expect_equal(cli.exit_usage, cli.route(["pokerface"]))
}

def test_unknown_command_exits_two() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "frobnicate"]))
}

def test_unknown_option_exits_two() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "version", "--wat"]))
}

def test_unknown_short_option_exits_two() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "-x"]))
}

def test_missing_config_value_exits_two() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "--config"]))
}

def test_unimplemented_commands_report_not_implemented() {
  // `build` is T4.1's real command now; `config` is still a stub.
  expect_equal(cli.exit_failure, cli.route(["pokerface", "config"]))
}

def test_pull_without_args_is_usage() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "pull"]))
}

def test_pull_unknown_option_is_usage() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "pull", "--wat"]))
}

def test_cache_without_subcommand_is_usage() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "cache"]))
}

def test_cache_unknown_option_is_usage() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "cache", "ls", "--wat"]))
}

def test_resolve_without_args_is_usage() {
  expect_equal(cli.exit_usage, cli.route(["pokerface", "resolve"]))
}

def test_help_text_names_all_commands() {
  const text = cli.help_text()
  expect_true(text.index_of("resolve") >= 0)
  expect_true(text.index_of("pull") >= 0)
  expect_true(text.index_of("build") >= 0)
  expect_true(text.index_of("config") >= 0)
  expect_true(text.index_of("cache") >= 0)
  expect_true(text.index_of("version") >= 0)
}

def test_help_text_names_all_global_flags() {
  const text = cli.help_text()
  expect_true(text.index_of("--config") >= 0)
  expect_true(text.index_of("--verbose") >= 0)
  expect_true(text.index_of("--json") >= 0)
}

// T4.10: the help-text snapshot. These assertions pin the command and flag
// surface that docs/reference/cli.md documents — when one fails, update the
// reference page in the same change, so the docs cannot drift from --help.
def test_help_text_snapshot_matches_the_reference() {
  const text = cli.help_text()
  // Every routed command, in the help's own order.
  const commands = ["resolve", "pull", "build", "config", "cache", "version"]
  var i = 0
  var at = 0
  while i < commands.length() {
    const found = text.index_of("  " + commands[i] + " ")
    expect_true(found >= at)
    at = found
    i = i + 1
  }
  // The build command's own option surface.
  expect_true(text.index_of("Build and push the image described by pokerface.yaml") >= 0)
  // The global flags, each present exactly once in the flag list.
  const flags = ["--config <path>", "--verbose", "--json", "--help"]
  i = 0
  while i < flags.length() {
    expect_true(text.index_of(flags[i]) >= 0)
    i = i + 1
  }
  expect_true(text.index_of("-h, --help") >= 0)
  // The help no longer promises unimplemented commands.
  expect_true(text.index_of("not implemented yet") >= 0)
}

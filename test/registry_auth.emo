// T2.14 tests for authentication and the token service — run with `emo test`.
//
// The token layer (mint/verify/scope), the Basic exchange, the gate's
// routing decisions, and the config section all run in the interpreter; the
// router test pins the challenge headers and the pass/fail decisions at the
// dispatch level with auth enabled.

const auth = registry.auth
const api = registry.api

require "httpd"
require "json"
require "crypto"
require "file"

const test_key = "test-signing-key-0123456789abcdef"
const test_realm = "http://127.0.0.1:5000/token"
const test_service = "pokerface-registry"
const test_issuer = "pokerface-registry"

def auth_settings() registry.config.RegistryAuth {
  return registry.config.RegistryAuth.new(true, test_realm, test_service, test_issuer, 3600,
    [registry.config.AuthUser.new("alice", "wonderland")], test_key)
}

// ---------------------------------------------------------------------------
// base64url.

def test_base64url_round_trip() {
  const encoded = auth.base64url_encode("hello world")
  expect_true(encoded.index_of("+") < 0)
  expect_true(encoded.index_of("/") < 0)
  expect_true(encoded.index_of("=") < 0)
  case auth.base64url_decode(encoded) {
    (R.ok, data) then { expect_equal("hello world", data) }
    (R.error, why) then { expect_fail(why) }
  }
}

def test_base64url_rejects_broken_segments() {
  case auth.base64url_decode("a") {
    (R.error, _) then { expect_true(true) }
    (R.ok, _) then { expect_fail("a one-character segment decoded") }
  }
}

// ---------------------------------------------------------------------------
// Tokens.

def test_mint_and_verify_round_trip() {
  case auth.mint_token(auth_settings(), "alice", ["repository:acme/app:pull,push"], 1000) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, token) then {
      case auth.verify_token(auth_settings(), token, 1500) {
        (R.error, why) then { expect_fail(why) }
        (R.ok, verified) then {
          expect_equal("alice", verified.subject)
          expect_equal(1, verified.scopes.length())
          expect_true(auth.scope_allows(verified.scopes, "acme/app", "pull"))
          expect_true(auth.scope_allows(verified.scopes, "acme/app", "push"))
        }
      }
    }
  }
}

def test_verify_rejects_a_foreign_key() {
  case auth.mint_token(auth_settings(), "alice", [], 1000) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, token) then {
      const stranger = registry.config.RegistryAuth.new(true, test_realm, test_service, test_issuer, 3600,
        [registry.config.AuthUser.new("alice", "wonderland")], "another-key")
      case auth.verify_token(stranger, token, 1500) {
        (R.error, why) then { expect_true(why.index_of("signature") >= 0) }
        (R.ok, _) then { expect_fail("a foreign key verified a token") }
      }
    }
  }
}

def test_verify_rejects_an_expired_token() {
  case auth.mint_token(auth_settings(), "alice", [], 1000) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, token) then {
      case auth.verify_token(auth_settings(), token, 1000 + 3600) {
        (R.error, why) then { expect_true(why.index_of("expired") >= 0) }
        (R.ok, _) then { expect_fail("an expired token verified") }
      }
    }
  }
}

def test_verify_rejects_a_token_before_its_window() {
  case auth.mint_token(auth_settings(), "alice", [], 5000) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, token) then {
      case auth.verify_token(auth_settings(), token, 4000) {
        (R.error, why) then { expect_true(why.index_of("not valid yet") >= 0) }
        (R.ok, _) then { expect_fail("a future token verified") }
      }
    }
  }
}

def test_verify_rejects_a_tampered_payload() {
  case auth.mint_token(auth_settings(), "alice", [], 1000) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, token) then {
      const parts = token.split(".")
      const forged = parts[0] + "." + parts[1] + "." + "Zm9yZWlnbg"
      case auth.verify_token(auth_settings(), forged, 1500) {
        (R.error, why) then { expect_true(why.index_of("signature") >= 0) }
        (R.ok, _) then { expect_fail("a forged token verified") }
      }
    }
  }
}

def test_verify_rejects_malformed_tokens() {
  case auth.verify_token(auth_settings(), "nonsense", 1500) {
    (R.error, why) then { expect_true(why.index_of("malformed") >= 0) }
    (R.ok, _) then { expect_fail("nonsense verified") }
  }
  case auth.verify_token(auth_settings(), "a.b", 1500) {
    (R.error, why) then { expect_true(why.index_of("malformed") >= 0) }
    (R.ok, _) then { expect_fail("two segments verified") }
  }
}

def test_verify_rejects_a_foreign_issuer() {
  case auth.mint_token(auth_settings(), "alice", [], 1000) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, token) then {
      const other = registry.config.RegistryAuth.new(true, test_realm, test_service, "someone-else", 3600,
        [registry.config.AuthUser.new("alice", "wonderland")], test_key)
      case auth.verify_token(other, token, 1500) {
        (R.error, why) then { expect_true(why.index_of("issuer") >= 0) }
        (R.ok, _) then { expect_fail("a foreign issuer verified") }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Scopes.

def test_scope_allows_actions_and_names() {
  const scopes = ["repository:acme/app:pull,push", "repository:other/repo:pull"]
  expect_true(auth.scope_allows(scopes, "acme/app", "pull"))
  expect_true(auth.scope_allows(scopes, "acme/app", "push"))
  expect_true(auth.scope_allows(scopes, "other/repo", "pull"))
  expect_true(!auth.scope_allows(scopes, "other/repo", "push"))
  expect_true(!auth.scope_allows(scopes, "acme/other", "pull"))
  expect_true(!auth.scope_allows([], "acme/app", "pull"))
}

def test_scope_names_repository() {
  expect_equal("acme/app", auth.scope_names_repository("repository:acme/app:pull,push"))
  expect_equal("", auth.scope_names_repository("repository:nocolon"))
  expect_equal("", auth.scope_names_repository("registry:catalog:*"))
}

// ---------------------------------------------------------------------------
// The challenge and the 401.

def test_challenge_header_shape() {
  const settings = auth_settings()
  expect_equal("Bearer realm=\"" + test_realm + "\",service=\"" + test_service + "\"",
    auth.challenge_header(settings, "", ""))
  expect_equal("Bearer realm=\"" + test_realm + "\",service=\"" + test_service
    + "\",scope=\"repository:acme/app:pull\"",
    auth.challenge_header(settings, "repository:acme/app:pull", ""))
  expect_equal("Bearer realm=\"" + test_realm + "\",service=\"" + test_service
    + "\",scope=\"repository:acme/app:pull\",error=\"expired_token\"",
    auth.challenge_header(settings, "repository:acme/app:pull", "expired_token"))
}

// ---------------------------------------------------------------------------
// The token endpoint.

def basic_request(path String, query Map[String, String], credentials String) httpd.Request {
  var headers = []
  if credentials != "" {
    headers = headers.append(("Authorization", "Basic " + base64_text(credentials)))
  }
  return httpd.Request.new(
    method: "GET",
    target: path,
    path: path,
    query: query,
    proto: "HTTP/1.1",
    headers: headers,
    body: "",
    params: Map.new()
  )
}

def base64_text(text String) String {
  return base64.encode(text)
}

def scope_query(scope String) Map[String, String] {
  const query = Map.new()
  query.set("scope", scope)
  return query
}

def test_token_endpoint_issues_a_scoped_token() {
  const response = auth.handle_token(basic_request("/token", scope_query("repository:acme/app:pull"), "alice:wonderland"), auth_settings(), 1000)
  expect_equal(200, response.status)
  case json.decode(response.body) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, doc) then {
      if doc.is(json.JsonObject) {
        const entries = doc.entries()
        var token = ""
        var expires_in = 0
        var issued_at = ""
        var i = 0
        while i < entries.length() {
          const (key, value) = entries[i]
          if key == "token" && value.is(json.JsonString) {
            token = value.as_string()
          } else {
            if key == "expires_in" && value.is(json.JsonInt) {
              expires_in = value.as_int()
            } else {
              if key == "issued_at" && value.is(json.JsonString) {
                issued_at = value.as_string()
              }
            }
          }
          i = i + 1
        }
        expect_true(token != "")
        expect_equal(3600, expires_in)
        expect_true(issued_at.index_of("T") >= 0)
        case auth.verify_token(auth_settings(), token, 1500) {
          (R.error, why) then { expect_fail(why) }
          (R.ok, verified) then {
            expect_true(auth.scope_allows(verified.scopes, "acme/app", "pull"))
            expect_true(!auth.scope_allows(verified.scopes, "acme/app", "push"))
          }
        }
      } else {
        expect_fail("the token response is not an object")
      }
    }
  }
}

def test_token_endpoint_rejects_bad_credentials() {
  const wrong_password = auth.handle_token(basic_request("/token", Map.new(), "alice:nope"), auth_settings(), 1000)
  expect_equal(401, wrong_password.status)
  expect_equal(api.code_unauthorized, error_field(wrong_password.body, "code"))
  const unknown_user = auth.handle_token(basic_request("/token", Map.new(), "bob:builder"), auth_settings(), 1000)
  expect_equal(401, unknown_user.status)
  const no_credentials = auth.handle_token(basic_request("/token", Map.new(), ""), auth_settings(), 1000)
  expect_equal(401, no_credentials.status)
  // The two failures never distinguish themselves.
  expect_equal(error_field(wrong_password.body, "message"), error_field(unknown_user.body, "message"))
}

def test_token_endpoint_rejects_invalid_scopes() {
  const response = auth.handle_token(basic_request("/token", scope_query("repository:ACME/app:pull"), "alice:wonderland"), auth_settings(), 1000)
  expect_equal(400, response.status)
  const action = auth.handle_token(basic_request("/token", scope_query("repository:acme/app:steal"), "alice:wonderland"), auth_settings(), 1000)
  expect_equal(400, action.status)
}

def test_token_endpoint_methods() {
  const delete_request = httpd.Request.new(
    method: "DELETE",
    target: "/token",
    path: "/token",
    query: Map.new(),
    proto: "HTTP/1.1",
    headers: [("Authorization", "Basic " + base64_text("alice:wonderland"))],
    body: "",
    params: Map.new()
  )
  const response = auth.handle_token(delete_request, auth_settings(), 1000)
  expect_equal(405, response.status)
  expect_equal("GET, POST", header_value(response.headers, "allow"))
}

// ---------------------------------------------------------------------------
// The gate's routing decisions.

def gate_request(method String, path String, token String) httpd.Request {
  var headers = []
  if token != "" {
    headers = headers.append(("Authorization", "Bearer " + token))
  }
  return httpd.Request.new(
    method: method,
    target: path,
    path: path,
    query: Map.new(),
    proto: "HTTP/1.1",
    headers: headers,
    body: "",
    params: Map.new()
  )
}

def probe_token() String {
  case auth.mint_token(auth_settings(), "alice", [], 1000) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def pull_token() String {
  case auth.mint_token(auth_settings(), "alice", ["repository:acme/app:pull"], 1000) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def push_token() String {
  case auth.mint_token(auth_settings(), "alice", ["repository:acme/app:push,pull"], 1000) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def test_check_token_decisions() {
  const settings = auth_settings()
  // A probe passes with any token and fails without one.
  case auth.check_token(gate_request("GET", "/v2/", probe_token()), settings, "probe", "", "", 1500) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail(why) }
  }
  case auth.check_token(gate_request("GET", "/v2/", ""), settings, "probe", "", "", 1500) {
    (R.error, why) then { expect_true(why.index_of("no bearer token") >= 0) }
    (R.ok, _) then { expect_fail("a probe passed without a token") }
  }
  // A pull token reads; it does not push.
  case auth.check_token(gate_request("GET", "/v2/acme/app/manifests/latest", pull_token()), settings, "repository", "acme/app", "pull", 1500) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail(why) }
  }
  case auth.check_token(gate_request("PUT", "/v2/acme/app/manifests/v1", pull_token()), settings, "repository", "acme/app", "push", 1500) {
    (R.error, why) then { expect_true(why.index_of("does not grant") >= 0) }
    (R.ok, _) then { expect_fail("a pull-only token pushed") }
  }
  // A push token uploads.
  case auth.check_token(gate_request("POST", "/v2/acme/app/blobs/uploads/", push_token()), settings, "repository", "acme/app", "push", 1500) {
    (R.ok, _) then { expect_true(true) }
    (R.error, why) then { expect_fail(why) }
  }
  // Cross-repository access is denied.
  case auth.check_token(gate_request("GET", "/v2/other/app/manifests/latest", pull_token()), settings, "repository", "other/app", "pull", 1500) {
    (R.error, why) then { expect_true(why.index_of("does not grant") >= 0) }
    (R.ok, _) then { expect_fail("a foreign repository pull passed") }
  }
  // An expired token fails.
  case auth.check_token(gate_request("GET", "/v2/", probe_token()), settings, "probe", "", "", 10000) {
    (R.error, why) then { expect_true(why.index_of("expired") >= 0) }
    (R.ok, _) then { expect_fail("an expired token passed") }
  }
}

def test_required_access_kinds() {
  const (probe_kind, _, _) = auth.required_access("/v2/", "GET")
  expect_equal("probe", probe_kind)
  const (health_kind, _, _) = auth.required_access("/healthz", "GET")
  expect_equal("public", health_kind)
  const (token_kind, _, _) = auth.required_access("/token", "GET")
  expect_equal("public", token_kind)
  const (get_kind, get_repo, get_action) = auth.required_access("/v2/acme/app/manifests/latest", "GET")
  expect_equal("repository", get_kind)
  expect_equal("acme/app", get_repo)
  expect_equal("pull", get_action)
  const (put_kind, put_repo, put_action) = auth.required_access("/v2/acme/app/manifests/v1", "PUT")
  expect_equal("push", put_action)
  expect_equal("acme/app", put_repo)
  const (post_kind, post_repo, post_action) = auth.required_access("/v2/acme/app/blobs/uploads/", "POST")
  expect_equal("push", post_action)
  expect_equal("acme/app", post_repo)
  const (blob_kind, blob_repo, blob_action) = auth.required_access("/v2/acme/app/blobs/sha256:1111111111111111111111111111111111111111111111111111111111111111", "GET")
  expect_equal("pull", blob_action)
  expect_equal("acme/app", blob_repo)
  const (patch_kind, _, patch_action) = auth.required_access("/v2/acme/app/blobs/uploads/sess-1", "PATCH")
  expect_equal("repository", patch_kind)
  expect_equal("push", patch_action)
}


def auth_config() registry.config.RegistryConfig {
  return registry.config.RegistryConfig.new(
    registry.config.RegistryListen.new("127.0.0.1", 5000),
    "/tmp/pf-auth-router",
    "/tmp/pf-auth-router/registry.db",
    registry.config.RegistryStore.new("fs", "/tmp/pf-auth-router/blobs", registry.config.default_s3()),
    registry.config.RegistryLimits.new(16777216, 1048576, 30, 5),
    "/tmp/pf-auth-router/shutdown",
    "<test>",
    auth_settings(),
    registry.config.ObservabilityConfig.new(false, false))
}

def auth_service() registry.router.Service {
  return registry.router.Service.new(auth_config(), AuthFakeDb.new(), AuthFakeHealth.new(), AuthFakeStore.new(), AuthFakeLinks.new(), AuthFakeManifests.new(), AuthFakeUploads.new(), AuthFakeWriter.new(), AuthFakeTags.new(), AuthFakeMetricsSink.new())
}

// The router gates with the real clock, so these mint at now.
def probe_token_now() String {
  case auth.mint_token(auth_settings(), "alice", [], registry.db.now_seconds()) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def pull_token_now() String {
  case auth.mint_token(auth_settings(), "alice", ["repository:acme/app:pull"], registry.db.now_seconds()) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def push_token_now() String {
  case auth.mint_token(auth_settings(), "alice", ["repository:acme/app:push,pull"], registry.db.now_seconds()) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def test_the_router_challenges_protected_routes() {
  const service = auth_service()
  const bare_probe = registry.router.handle(gate_request("GET", "/v2/", ""), service)
  expect_equal(401, bare_probe.status)
  expect_equal(api.code_unauthorized, error_field(bare_probe.body, "code"))
  expect_true(header_value(bare_probe.headers, "www-authenticate").index_of("Bearer realm=\"http://127.0.0.1:5000/token\"") >= 0)
  // A valid probe token passes.
  const ok_probe = registry.router.handle(gate_request("GET", "/v2/", probe_token_now()), service)
  expect_equal(200, ok_probe.status)
  // A pull token reads a manifest (the fake store answers absent → 404 from
  // the route, not 401 from the gate).
  const read = registry.router.handle(gate_request("GET", "/v2/acme/app/manifests/latest", pull_token_now()), service)
  expect_equal(404, read.status)
  expect_equal(api.code_manifest_unknown, error_field(read.body, "code"))
  // The same token without scope fails with insufficient_scope in the challenge.
  const foreign = registry.router.handle(gate_request("GET", "/v2/other/app/manifests/latest", pull_token_now()), service)
  expect_equal(401, foreign.status)
  expect_true(header_value(foreign.headers, "www-authenticate").index_of("error=\"insufficient_scope\"") >= 0)
  // A push token starts an upload.
  const upload = registry.router.handle(gate_request("POST", "/v2/acme/app/blobs/uploads/", push_token_now()), service)
  expect_equal(202, upload.status)
  const pull_upload = registry.router.handle(gate_request("POST", "/v2/acme/app/blobs/uploads/", pull_token_now()), service)
  expect_equal(401, pull_upload.status)
  expect_true(header_value(pull_upload.headers, "www-authenticate").index_of("error=\"insufficient_scope\"") >= 0)
}

def test_health_and_token_stay_public_with_auth_enabled() {
  const service = auth_service()
  const health = registry.router.handle(gate_request("GET", "/healthz", ""), service)
  expect_equal(200, health.status)
  const ready = registry.router.handle(gate_request("GET", "/readyz", ""), service)
  expect_equal(200, ready.status)
  const token_response = registry.router.handle(basic_request("/token", scope_query("repository:acme/app:pull"), "alice:wonderland"), service)
  expect_equal(200, token_response.status)
}

// ---------------------------------------------------------------------------
// Config: the auth section.

def auth_tmp_base() String {
  var base = "/tmp/"
  case os.getenv("TMPDIR") {
    (R.ok, tmp) then {
      if tmp != "" {
        base = tmp
      }
    }
    (R.error, _) then { base = "/tmp/" }
  }
  if base.substring(base.length() - 1, 1) != "/" {
    base = base + "/"
  }
  return base + "pokerface-registry-auth-cfg-" + os.getpid().to_string() + "-"
}

def write_file(path String, text String) {
  case file.write(path, text) {
    (R.error, why) then { expect_fail("cannot write " + path + ": " + why) }
    (R.ok, _) then { expect_true(true) }
  }
}

def load_config(path String, env Map[String, String]) (R, registry.config.RegistryConfig) {
  return registry.config.load(RegEnv.new(env), path)
}

class RegEnv {
  def init(values Map[String, String]) {
    self.values = values
  }

  def getenv(name String) (R, String) {
    if self.values.has(name) {
      return (R.ok, self.values.get(name))
    }
    return (R.error, "not set")
  }
}

def test_auth_config_parses_and_validates() {
  const base = auth_tmp_base()
  const path = base + "auth.yaml"
  write_file(path, "listen:\n  host: 127.0.0.1\n  port: 5001\ndata_dir: " + base + "data\nauth:\n  enabled: true\n  realm: \"http://r/token\"\n  service: \"svc\"\n  issuer: \"iss\"\n  token_ttl: 120\n  signing_key: " + "\"topsecret\"\n  users:\n    - username: alice\n      password: wonderland\n    - username: bob\n      password_file: " + base + "bob-secret\n")
  write_file(base + "bob-secret", "builder\n")
  case load_config(path, Map.new()) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, config) then {
      expect_true(config.auth.enabled)
      expect_equal("http://r/token", config.auth.realm)
      expect_equal("svc", config.auth.service)
      expect_equal("iss", config.auth.issuer)
      expect_equal(120, config.auth.token_ttl)
      expect_equal("topsecret", config.auth.signing_key)
      expect_equal(2, config.auth.users.length())
      expect_equal("alice", config.auth.users[0].username)
      expect_equal("wonderland", config.auth.users[0].password)
      expect_equal("bob", config.auth.users[1].username)
      expect_equal("builder", config.auth.users[1].password)
    }
  }
}

def test_auth_config_requires_a_key_when_enabled() {
  const base = auth_tmp_base()
  const path = base + "nokey.yaml"
  write_file(path, "listen:\n  host: 127.0.0.1\n  port: 5001\ndata_dir: " + base + "data\nauth:\n  enabled: true\n  users:\n    - username: alice\n      password: wonderland\n")
  case load_config(path, Map.new()) {
    (R.error, why) then { expect_true(why.index_of("signing_key") >= 0) }
    (R.ok, _) then { expect_fail("auth without a signing key loaded") }
  }
}

def test_auth_config_env_key_override() {
  const base = auth_tmp_base()
  const path = base + "envkey.yaml"
  write_file(path, "listen:\n  host: 127.0.0.1\n  port: 5001\ndata_dir: " + base + "data\nauth:\n  enabled: true\n  users:\n    - username: alice\n      password: wonderland\n")
  const env = Map.new(("POKERFACE_REGISTRY_AUTH_SIGNING_KEY", "env-secret"))
  case load_config(path, env) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, config) then {
      expect_equal("env-secret", config.auth.signing_key)
      expect_equal("http://127.0.0.1:5001/token", config.auth.realm)
    }
  }
}

// The challenge's realm behind a TLS proxy: the public token URL arrives
// by environment, overriding the listen-derived default.
def test_auth_config_env_realm_override() {
  const base = auth_tmp_base()
  const path = base + "envrealm.yaml"
  write_file(path, "listen:\n  host: 127.0.0.1\n  port: 5001\ndata_dir: " + base + "data\nauth:\n  enabled: true\n  users:\n    - username: alice\n      password: wonderland\n")
  const env = Map.new(("POKERFACE_REGISTRY_AUTH_SIGNING_KEY", "s"), ("POKERFACE_REGISTRY_AUTH_REALM", "https://registry.example.com/token"), ("POKERFACE_REGISTRY_AUTH_SERVICE", "public-registry"))
  case load_config(path, env) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, config) then {
      expect_equal("https://registry.example.com/token", config.auth.realm)
      expect_equal("public-registry", config.auth.service)
    }
  }
}

def test_auth_config_unknown_field_is_refused() {
  const base = auth_tmp_base()
  const path = base + "unknown.yaml"
  write_file(path, "listen:\n  host: 127.0.0.1\n  port: 5001\ndata_dir: " + base + "data\nauth:\n  enabled: false\n  magic: true\n")
  case load_config(path, Map.new()) {
    (R.error, why) then { expect_true(why.index_of("auth.magic") >= 0) }
    (R.ok, _) then { expect_fail("an unknown auth field loaded") }
  }
}

def test_the_summary_never_shows_secrets() {
  const base = auth_tmp_base()
  const path = base + "summary.yaml"
  write_file(path, "listen:\n  host: 127.0.0.1\n  port: 5001\ndata_dir: " + base + "data\nauth:\n  enabled: true\n  signing_key: \"topsecret\"\n  users:\n    - username: alice\n      password: wonderland\n")
  case load_config(path, Map.new()) {
    (R.error, why) then { expect_fail(why) }
    (R.ok, config) then {
      const text = registry.config.summary(config)
      expect_true(text.index_of("topsecret") < 0)
      expect_true(text.index_of("wonderland") < 0)
      expect_true(text.index_of("auth=enabled") >= 0)
      expect_true(text.index_of("signing_key=<set>") >= 0)
    }
  }
}

// ---------------------------------------------------------------------------
// Helpers shared with the endpoint tests.

def error_field(body String, field String) String {
  case json.decode(body) {
    (R.error, _) then { return "" }
    (R.ok, doc) then { return scan_errors(doc, field) }
  }
}

def scan_errors(doc json.Json, field String) String {
  if doc.is(json.JsonObject) {
    const entries = doc.entries()
    var i = 0
    while i < entries.length() {
      const (key, value) = entries[i]
      if key == "errors" {
        if value.is(json.JsonArray) {
          const items = value.items()
          if items.length() > 0 {
            return scan_member(items[0], field)
          }
        }
      }
      i = i + 1
    }
  }
  return ""
}

def scan_member(doc json.Json, field String) String {
  if doc.is(json.JsonObject) {
    const entries = doc.entries()
    var i = 0
    while i < entries.length() {
      const (key, value) = entries[i]
      if key == field {
        if value.is(json.JsonString) {
          return value.as_string()
        }
      }
      i = i + 1
    }
  }
  return ""
}

def header_value(headers Array[(String, String)], name String) String {
  var i = 0
  while i < headers.length() {
    const (key, value) = headers[i]
    if key.lower() == name.lower() {
      return value
    }
    i = i + 1
  }
  return ""
}


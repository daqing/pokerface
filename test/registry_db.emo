// T2.2 tests for the database layer's pure parts — run with `emo test`.
// The sqlite3 package refuses interpreted foreign calls, so the real CRUD
// coverage is registry/db_selftest.emo (compiled); this module covers the
// migration table, the pragmas, and the path helpers.

const reg_db = registry.db

require "os"
require "file"

def db_tmp_base() String {
  var base = "/tmp/"
  case os.getenv("TMPDIR") {
    (R.ok, tmp) then {
      if tmp != "" {
        base = tmp
      }
    }
    (R.error, _) then { base = "/tmp/" }
  }
  if base.substring(base.length() - 1, 1) != "/" {
    base = base + "/"
  }
  return base
}

def db_tmp(name String) String {
  return db_tmp_base() + "pokerface-registry-db-test-" + os.getpid().to_string() + "-" + name
}

def migration_sql(migration registry.db.Migration) String {
  var text = ""
  var i = 0
  while i < migration.statements.length() {
    text = text + migration.statements[i] + "\n"
    i = i + 1
  }
  return text
}

def all_migration_sql() String {
  var text = ""
  const list = reg_db.migrations()
  var i = 0
  while i < list.length() {
    text = text + migration_sql(list[i])
    i = i + 1
  }
  return text
}

def test_migrations_start_at_one_and_rise() {
  const list = reg_db.migrations()
  expect_true(list.length() > 0)
  expect_equal(1, list[0].version)
  var i = 1
  while i < list.length() {
    expect_true(list[i].version > list[i - 1].version)
    i = i + 1
  }
}

def test_migration_names_are_unique_and_nonempty() {
  const list = reg_db.migrations()
  var i = 0
  while i < list.length() {
    expect_true(list[i].name != "")
    var j = 0
    while j < i {
      expect_true(list[j].name != list[i].name)
      j = j + 1
    }
    i = i + 1
  }
}

def test_every_migration_has_statements() {
  const list = reg_db.migrations()
  var i = 0
  while i < list.length() {
    expect_true(list[i].statements.length() > 0)
    i = i + 1
  }
}

def test_initial_migration_creates_every_table() {
  const sql = all_migration_sql()
  expect_true(sql.index_of("CREATE TABLE IF NOT EXISTS repositories") >= 0)
  expect_true(sql.index_of("CREATE TABLE IF NOT EXISTS manifests") >= 0)
  expect_true(sql.index_of("CREATE TABLE IF NOT EXISTS tags") >= 0)
  expect_true(sql.index_of("CREATE TABLE IF NOT EXISTS blobs") >= 0)
  expect_true(sql.index_of("CREATE TABLE IF NOT EXISTS uploads") >= 0)
}

def test_initial_migration_declares_the_constraints() {
  const sql = all_migration_sql()
  expect_true(sql.index_of("name TEXT NOT NULL UNIQUE") >= 0)
  expect_true(sql.index_of("UNIQUE (repository_id, digest)") >= 0)
  expect_true(sql.index_of("PRIMARY KEY (repository_id, tag)") >= 0)
  expect_true(sql.index_of("FOREIGN KEY (repository_id, digest)") >= 0)
  expect_true(sql.index_of("CHECK (state IN ('pending', 'completed', 'cancelled'))") >= 0)
  expect_true(sql.index_of("CHECK (size >= 0)") >= 0)
}

def test_pragmas_configure_wal_and_busy_timeout() {
  const list = reg_db.pragmas()
  var sql = ""
  var i = 0
  while i < list.length() {
    sql = sql + list[i] + "\n"
    i = i + 1
  }
  expect_true(sql.index_of("journal_mode=WAL") >= 0)
  expect_true(sql.index_of("busy_timeout=5000") >= 0)
  expect_true(sql.index_of("foreign_keys=ON") >= 0)
}

def test_upload_states_are_the_checked_values() {
  expect_equal("pending", reg_db.upload_pending)
  expect_equal("completed", reg_db.upload_completed)
  expect_equal("cancelled", reg_db.upload_cancelled)
}

def test_parent_dir_splits_relative_and_absolute_paths() {
  expect_equal("data", reg_db.parent_dir("data/registry.db"))
  expect_equal("/tmp", reg_db.parent_dir("/tmp/registry.db"))
  expect_equal("", reg_db.parent_dir("registry.db"))
  expect_equal("/", reg_db.parent_dir("/registry.db"))
}

def test_ensure_parent_creates_the_directory() {
  const dir = db_tmp("data")
  case reg_db.ensure_parent(dir + "/registry.db") {
    (R.ok, _) then {
      case os.list_dir(dir) {
        (R.ok, entries) then { expect_equal(0, entries.length()) }
        (R.error, why) then { expect_fail("cannot list " + dir + ": " + why) }
      }
    }
    (R.error, why) then { expect_fail("ensure_parent failed: " + why) }
  }
}

def test_ensure_parent_rejects_a_file_in_the_way() {
  const path = db_tmp("blocked")
  case file.write(path, "not a directory") {
    (R.ok, _) then { }
    (R.error, why) then { expect_fail("cannot write " + path + ": " + why) }
  }
  case reg_db.ensure_parent(path + "/registry.db") {
    (R.ok, _) then { expect_fail("expected a not-a-directory error") }
    (R.error, why) then { expect_true(why.index_of("not a directory") >= 0) }
  }
}

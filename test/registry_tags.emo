def tags_config(auth_enabled Bool) registry.config.RegistryConfig {
  return registry.config.RegistryConfig.new(
    registry.config.RegistryListen.new("127.0.0.1", 5000),
    "/tmp/pf-tags-router",
    "/tmp/pf-tags-router/registry.db",
    registry.config.RegistryStore.new("fs", "/tmp/pf-tags-router/blobs", registry.config.default_s3()),
    registry.config.RegistryLimits.new(16777216, 1048576, 30, 5),
    "/tmp/pf-tags-router/shutdown",
    "<test>",
    registry.config.RegistryAuth.new(auth_enabled, "http://127.0.0.1:5000/token", "pokerface-registry", "pokerface-registry", 3600,
      [registry.config.AuthUser.new("alice", "wonderland")], "tags-test-key")
  )
}

def tags_service(auth_enabled Bool) registry.router.Service {
  return registry.router.Service.new(tags_config(auth_enabled), TagsFakeDb.new(), TagsFakeHealth.new(), TagsFakeStore.new(), TagsFakeLinks.new(), TagsFakeManifests.new(), TagsFakeUploads.new(), TagsFakeWriter.new(), FakeTagList.new(true, ["v1", "v2"]))
}

def tags_bearer(query Map[String, String], token String) httpd.Request {
  var headers = []
  if token != "" {
    headers = headers.append(("Authorization", "Bearer " + token))
  }
  return httpd.Request.new(
    method: "GET",
    target: "/v2/acme/app/tags/list",
    path: "/v2/acme/app/tags/list",
    query: query,
    proto: "HTTP/1.1",
    headers: headers,
    body: "",
    params: Map.new()
  )
}

def tags_token(scope String) String {
  const settings = registry.config.RegistryAuth.new(true, "http://127.0.0.1:5000/token", "pokerface-registry", "pokerface-registry", 3600,
    [registry.config.AuthUser.new("alice", "wonderland")], "tags-test-key")
  case registry.auth.mint_token(settings, "alice", [scope], registry.db.now_seconds()) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def test_the_listing_needs_pull_when_auth_is_enabled() {
  const service = tags_service(true)
  const anonymous = registry.router.handle(tags_bearer(Map.new(), ""), service)
  expect_equal(401, anonymous.status)
  expect_true(header_value(anonymous.headers, "www-authenticate").index_of("scope=\"repository:acme/app:pull\"") >= 0)
  const wrong_repo = registry.router.handle(tags_bearer(Map.new(), tags_token("repository:other/app:pull")), service)
  expect_equal(401, wrong_repo.status)
  const ok = registry.router.handle(tags_bearer(Map.new(), tags_token("repository:acme/app:pull")), service)
  expect_equal(200, ok.status)
  expect_equal(2, tags_of(ok.body).length())
}

def test_the_listing_is_open_without_auth() {
  const service = tags_service(false)
  const response = registry.router.handle(tags_bearer(Map.new(), ""), service)
  expect_equal(200, response.status)
  expect_equal("acme/app", field_of(response.body, "name"))
}

// T2.7 tests for the OCI error format, request ids, and the /v2/ router —
// run with `emo test`.

const api = registry.api
const config_mod = registry.config

require "httpd"
require "json"
require "os"
require "file"

def api_tmp_base() String {
  var base = "/tmp/"
  case os.getenv("TMPDIR") {
    (R.ok, tmp) then {
      if tmp != "" {
        base = tmp
      }
    }
    (R.error, _) then { base = "/tmp/" }
  }
  if base.substring(base.length() - 1, 1) != "/" {
    base = base + "/"
  }
  return base
}

def api_tmp(name String) String {
  return api_tmp_base() + "pokerface-registry-api-" + os.getpid().to_string() + "-" + name
}

def make_config(name String) registry.config.RegistryConfig {
  const data = api_tmp(name)
  return registry.config.RegistryConfig.new(
    registry.config.RegistryListen.new("127.0.0.1", 5000),
    data,
    data + "/registry.db",
    registry.config.RegistryStore.new("fs", data + "/blobs", registry.config.default_s3()),
    registry.config.RegistryLimits.new(16777216, 1048576, 30, 5),
    data + "/registry.shutdown",
    "<test>",
    registry.config.default_auth(),
    registry.config.ObservabilityConfig.new(false, false))
}


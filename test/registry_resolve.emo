def res_config(auth_enabled Bool) registry.config.RegistryConfig {
  return registry.config.RegistryConfig.new(
    registry.config.RegistryListen.new("127.0.0.1", 5000),
    "/tmp/pf-resolve-router",
    "/tmp/pf-resolve-router/registry.db",
    registry.config.RegistryStore.new("fs", "/tmp/pf-resolve-router/blobs", registry.config.default_s3()),
    registry.config.RegistryLimits.new(16777216, 1048576, 30, 5),
    "/tmp/pf-resolve-router/shutdown",
    "<test>",
    registry.config.RegistryAuth.new(auth_enabled, "http://127.0.0.1:5000/token", "pokerface-registry", "pokerface-registry", 3600,
      [registry.config.AuthUser.new("alice", "wonderland")], "resolve-test-key")
  )
}

def res_service(auth_enabled Bool) registry.router.Service {
  const body = manifest_with_revision("0123abcd")
  return registry.router.Service.new(res_config(auth_enabled), ResFakeDb.new(), ResFakeHealth.new(), ResFakeStore.new(), ResFakeLinks.new(), ResFakeManifests.new(manifest_payload(body)), ResFakeUploads.new(), ResFakeWriter.new(), ResFakeTags.new())
}

def bearer_request(query Map[String, String], token String) httpd.Request {
  var headers = []
  if token != "" {
    headers = headers.append(("Authorization", "Bearer " + token))
  }
  return httpd.Request.new(
    method: "GET",
    target: "/api/v1/resolve",
    path: "/api/v1/resolve",
    query: query,
    proto: "HTTP/1.1",
    headers: headers,
    body: "",
    params: Map.new()
  )
}

def res_token(scope String) String {
  const settings = registry.config.RegistryAuth.new(true, "http://127.0.0.1:5000/token", "pokerface-registry", "pokerface-registry", 3600,
    [registry.config.AuthUser.new("alice", "wonderland")], "resolve-test-key")
  case registry.auth.mint_token(settings, "alice", [scope], registry.db.now_seconds()) {
    (R.ok, token) then { return token }
    (R.error, why) then { expect_fail(why) }
  }
  return ""
}

def test_the_router_dispatches_resolve_without_auth() {
  const service = res_service(false)
  const response = registry.router.handle(resolve_request(tag_query("acme/app", "v1")), service)
  expect_equal(200, response.status)
  expect_equal("0123abcd", field_of(response.body, "revision"))
  expect_equal("registry/2.0", header_value(response.headers, "docker-distribution-api-version"))
}

def test_the_router_challenges_resolve_with_auth_enabled() {
  const service = res_service(true)
  const anonymous = registry.router.handle(bearer_request(tag_query("acme/app", "v1"), ""), service)
  expect_equal(401, anonymous.status)
  expect_true(header_value(anonymous.headers, "www-authenticate").index_of("scope=\"repository:acme/app:pull\"") >= 0)
  const wrong_scope = registry.router.handle(bearer_request(tag_query("acme/app", "v1"), res_token("repository:other/app:pull")), service)
  expect_equal(401, wrong_scope.status)
  const ok = registry.router.handle(bearer_request(tag_query("acme/app", "v1"), res_token("repository:acme/app:pull")), service)
  expect_equal(200, ok.status)
  expect_equal("0123abcd", field_of(ok.body, "revision"))
}


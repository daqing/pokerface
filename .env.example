# The distribution stack's values (T2.17) — copy to .env and edit. The
# compose file refuses to start without MINIO_ROOT_USER, MINIO_ROOT_PASSWORD,
# REGISTRY_SIGNING_KEY, and REGISTRY_DOMAIN. Never commit the real .env.
#
# The stack's MinIO and mc images are built locally (upstream stopped
# publishing community images in 2025); see docs/registry/deployment.md.
#
# One more file is required before the stack starts: deploy/registry.password
# (the auth account's password — read from a mounted file, never baked into
# an image or this file; gitignored). Generate it:
#   openssl rand -base64 24 | tr -d '\n' > deploy/registry.password
#   chmod 600 deploy/registry.password

# MinIO: the object store's root credentials. Generate the password —
#   openssl rand -base64 32
MINIO_ROOT_USER=pokerface
MINIO_ROOT_PASSWORD=change-me-generate-one

MINIO_BUCKET=pokerface
MINIO_REGION=us-east-1

# The domain Caddy serves and obtains certificates for. "localhost" uses
# Caddy's internal CA (dev only).
REGISTRY_DOMAIN=registry.example.com
REGISTRY_HTTP_PORT=80
REGISTRY_HTTPS_PORT=443

# Bearer-token auth: the signing key signs short-lived tokens (rotate by
# restarting with a new value — existing tokens invalidate immediately).
#   openssl rand -hex 32
REGISTRY_SIGNING_KEY=change-me-generate-a-32-byte-hex-key
REGISTRY_AUTH_ENABLED=true

// T4.1: the `pokerface build` command — read pokerface.yaml (the --config
// flag names it, otherwise it lives in the current directory), capture the
// Git metadata of the repository the context names, render the tag
// templates, and answer a build plan. `--dry-run` prints the plan and
// performs no build and no network requests.
//
// T4.2: without --dry-run the plan executes: the build tool (buildx, or
// podman as the fallback) runs with the log streamed to the terminal, and
// the image lands as a validated OCI layout in a temp directory.
//
// T4.3: when pokerface.yaml has a registry section, the layout then goes to
// that registry — blobs HEAD-checked and skipped when present, the manifest
// PUT under every rendered tag — and the digest is reported.
//
// `--platform` overrides the configured platforms (repeatable: --platform
// linux/amd64 --platform linux/arm64).
//
// pokerface.yaml is the BUILD config (src.config.load) — a different file
// from the client's config.yaml (src.settings.load), which only supplies
// the registry token here. Validation happens before anything prints: the
// config must parse, the context directory and Dockerfile must exist on
// disk, and the rendered tags must be collision-free. Spec:
// docs/spec/build-plan.md.

require "file"
require "os"
require "json"

def run(flags src.common.Flags, rest Array[String], env src.settings.EnvSource) Int64 {
  var dry_run = false
  var write_lock = false
  var commit_lock = false
  var platforms = []
  var i = 0
  while i < rest.length() {
    const arg = rest[i]
    if arg == "--dry-run" {
      dry_run = true
    } else {
      if arg == "--write-lock" {
        write_lock = true
      } else {
        if arg == "--commit" {
          commit_lock = true
        } else {
          if arg.starts_with("--platform=") {
            platforms = platforms.append(arg.substring(11, arg.length() - 11))
          } else {
            if arg == "--platform" {
              if i + 1 >= rest.length() {
                return src.errors.usage_report("build", "--platform expects a value (e.g. linux/amd64)", flags.json)
              }
              i = i + 1
              platforms = platforms.append(rest[i])
            } else {
              if arg.starts_with("-") {
                return src.errors.usage_report("build", "unknown option '" + arg + "' (known: --dry-run, --platform, --write-lock, --commit)", flags.json)
              }
              return src.errors.usage_report("build", "unexpected argument '" + arg + "' (build takes no positional arguments)", flags.json)
            }
          }
        }
      }
    }
    i = i + 1
  }
  if commit_lock && !write_lock {
    return src.errors.usage_report("build", "--commit commits the generated lock — pass --write-lock too", flags.json)
  }
  var config_path = flags.config
  if config_path == "" {
    config_path = os.getcwd() + "/pokerface.yaml"
  }

  case compose_plan(config_path, platforms) {
    (R.error, why) then { return src.errors.report("build", why, flags.json) }
    (R.ok, prepared) then {
      case check_dockerfile(prepared.plan) {
        (R.error, why) then { return src.errors.report("build", why, flags.json) }
        (R.ok, _) then {
          if dry_run {
            if flags.json {
              print_plan_json(prepared.plan)
            } else {
              print_plan(prepared.plan)
            }
            return src.common.exit_ok
          }
          return build_and_report(flags, prepared, env, config_path, write_lock, commit_lock)
        }
      }
    }
  }
}

// The config plus the plan and the Git facts it was rendered from — the dry
// run prints the plan, the real build feeds everything to the adapter and
// the push (the labels come from the metadata, the push switch from the
// config's registry section).
class Prepared {
  def init(config src.config.PokerfaceConfig, metadata src.build.GitMetadata, plan src.build.BuildPlan) {
    self.config = config
    self.metadata = metadata
    self.plan = plan
  }
}

// The real build: execute the plan in a fresh temp directory, then — when
// pokerface.yaml has a registry section — push the layout and report, and
// with --write-lock record the pushed digest in pokerface.lock.yaml next to
// pokerface.yaml (--commit makes that a local Git commit, never a push).
def build_and_report(flags src.common.Flags, prepared Prepared, env src.settings.EnvSource, config_path String, write_lock Bool, commit_lock Bool) Int64 {
  const work_dir = work_base() + "pokerface-build-" + os.getpid().to_string()
  case src.build.execute(prepared.plan, prepared.metadata, src.git.RealRunner.new(), src.build.RealStreamRunner.new(), work_dir, src.build.rfc3339_now()) {
    (R.error, why) then { return src.errors.report("build", why, flags.json) }
    (R.ok, out) then {
      var pushed = false
      var report = src.push.PushReport.new("", "", [], 0, 0, 0)
      if prepared.config.registry.url != "" {
        case push_layout(flags, prepared, env, out.layout) {
          (R.error, why) then { return src.errors.report("build", why, flags.json) }
          (R.ok, rep) then {
            pushed = true
            report = rep
          }
        }
      }
      var lock_path = ""
      var lock_commit = ""
      if write_lock {
        case write_lock_file(flags, prepared, config_path, out.tool, report, commit_lock) {
          (R.error, why) then { return src.errors.report("build", why, flags.json) }
          (R.ok, done) then {
            const (path, committed) = done
            lock_path = path
            lock_commit = committed
          }
        }
      }
      if flags.json {
        print_build_json(out, prepared.plan, pushed, report, lock_path, lock_commit)
      } else {
        print_build_text(out, prepared.plan, pushed, report, lock_path, lock_commit)
      }
      return src.common.exit_ok
    }
  }
}

// The push stage: the token comes from the client settings (env or the
// XDG config.yaml — the --config flag names the BUILD file here, never the
// client config), the endpoint from the image's host.
def push_layout(flags src.common.Flags, prepared Prepared, env src.settings.EnvSource, layout String) (R, src.push.PushReport) {
  var token = ""
  case src.settings.load(src.git.RealRunner.new(), env, "") {
    (R.error, why) then { return (R.error, why) }
    (R.ok, settings) then { token = settings.registry_token }
  }
  if flags.json {
    return src.push.push_layout(layout, prepared.plan.image, prepared.plan.tags, token, src.registry.HttpTransport.new(), src.push.RealHeadTransport.new(), src.push.push_params(), src.push.SilentProgress.new())
  }
  return src.push.push_layout(layout, prepared.plan.image, prepared.plan.tags, token, src.registry.HttpTransport.new(), src.push.RealHeadTransport.new(), src.push.push_params(), src.push.StdoutProgress.new())
}

// Writes the lock next to pokerface.yaml: the fresh entry (or the merge
// into the existing lock) carries this build's commit, the origin-derived
// source, the pushed digest, and the builder. --commit then records the
// file in the config's repository as a LOCAL commit — never a push.
// Answers (path, committed-sha-or-"").
def write_lock_file(flags src.common.Flags, prepared Prepared, config_path String, tool String, report src.push.PushReport, commit_lock Bool) (R, (String, String)) {
  const path = dir_of(config_path) + "/pokerface.lock.yaml"
  if report.digest == "" {
    return (R.error, "the lock records the pushed digest — configure registry in pokerface.yaml (or drop --write-lock)")
  }
  var source = ""
  if prepared.metadata.origin == "" {
    return (R.error, "the lock's source names the origin remote, and the context repository has none (git remote add origin …)")
  }
  case src.lockfile.parse_source(prepared.metadata.origin) {
    (R.error, why) then { return (R.error, "the lock's source cannot come from the origin remote '" + prepared.metadata.origin + "': " + why) }
    (R.ok, normalized) then { source = normalized }
  }
  case src.lockfile.entry_for(prepared.plan.image, prepared.plan.tags, report.digest, prepared.plan.platforms, builder_name(tool)) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, entry) then {
      var doc = src.lockfile.fresh_doc(entry, prepared.metadata.commit, source)
      case has_lock(path) {
        (R.error, why) then { return (R.error, why) }
        (R.ok, exists) then {
          if exists {
            case file.read(path) {
              (R.error, why) then { return (R.error, "cannot read the existing " + path + ": " + why) }
              (R.ok, text) then {
                case src.lockfile.load(text) {
                  (R.error, why) then { return (R.error, "the existing " + path + " does not parse — fix or remove it first: " + why) }
                  (R.ok, existing) then { doc = src.lockfile.merge(existing, entry, prepared.metadata.commit, source) }
                }
              }
            }
          }
        }
      }
      case file.write(path, src.lockfile.encode(doc)) {
        (R.error, why) then { return (R.error, "cannot write " + path + ": " + why) }
        (R.ok, _) then {
          if !commit_lock {
            return (R.ok, (path, ""))
          }
          const runner = src.git.RealRunner.new()
          case runner.run(["git", "-C", dir_of(config_path), "add", "--", "pokerface.lock.yaml"], 30.0) {
            (R.error, why) then { return (R.error, "git: cannot stage the lock: " + why) }
            (R.ok, _) then {
              case runner.run(["git", "-C", dir_of(config_path), "commit", "-m", "pokerface: update pokerface.lock.yaml", "--", "pokerface.lock.yaml"], 30.0) {
                (R.error, why) then { return (R.error, "git: cannot commit the lock: " + why) }
                (R.ok, _) then {
                  case runner.run(["git", "-C", dir_of(config_path), "rev-parse", "--short=8", "HEAD"], 10.0) {
                    (R.error, why) then { return (R.error, "git: cannot read the lock commit: " + why) }
                    (R.ok, sha) then { return (R.ok, (path, sha.trim())) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// The lock's builder field: the adapter's tool name mapped into the lock's
// known set.
def builder_name(tool String) String {
  if tool == "podman" {
    return "podman"
  }
  return "buildkit"
}

// The lock's existence, so a missing file means a fresh doc while an
// unreadable one means an error (never a silent clobber).
def has_lock(path String) (R, Bool) {
  const dir = dir_of(path)
  case os.list_dir(dir) {
    (R.error, why) then { return (R.error, "cannot list " + dir + ": " + why) }
    (R.ok, names) then {
      var i = 0
      while i < names.length() {
        if names[i] == "pokerface.lock.yaml" {
          return (R.ok, true)
        }
        i = i + 1
      }
      return (R.ok, false)
    }
  }
}

// The temp root for build work directories; a per-process name keeps
// concurrent runs apart. The layout is transient — push (T4.3) consumes it
// within the same invocation.
def work_base() String {
  var base = "/tmp/"
  case os.getenv("TMPDIR") {
    (R.ok, tmp) then {
      if tmp != "" {
        base = tmp
      }
    }
    (R.error, _) then { base = "/tmp/" }
  }
  if base.substring(base.length() - 1, 1) != "/" {
    base = base + "/"
  }
  return base
}

// The human build report: the tool, the layout, one line per unique digest,
// the tags, the push outcome, and the lock when written. The per-blob/tag
// progress lines have already streamed from the push itself.
def print_build_text(out src.build.BuildOutput, plan src.build.BuildPlan, pushed Bool, report src.push.PushReport, lock_path String, lock_commit String) {
  println("tool:       " + out.tool)
  println("layout:     " + out.layout)
  var seen = []
  var i = 0
  while i < out.entries.length() {
    const digest = out.entries[i].digest
    var printed = false
    var j = 0
    while j < seen.length() {
      if seen[j] == digest {
        printed = true
      }
      j = j + 1
    }
    if !printed {
      println("digest:     " + digest + " (" + out.entries[i].media_type + ")")
      seen = seen.append(digest)
    }
    i = i + 1
  }
  println("tags:       " + join(plan.tags, ", "))
  if pushed {
    println("pushed:     " + plan.image + " (" + report.uploaded.to_string() + " uploaded, " + report.skipped.to_string() + " skipped)")
  } else {
    println("(not pushed — pokerface.yaml has no registry section)")
  }
  if lock_path != "" {
    println("lock:       " + lock_path)
    if lock_commit != "" {
      println("lock commit: " + lock_commit)
    }
  }
}

// The machine build report: stable keys, script-friendly. `pushed` is false
// when no registry is configured; `digest` is then empty. The `lock` keys
// appear only with --write-lock.
def print_build_json(out src.build.BuildOutput, plan src.build.BuildPlan, pushed Bool, report src.push.PushReport, lock_path String, lock_commit String) {
  var digests = []
  var i = 0
  while i < out.entries.length() {
    digests = digests.append(json.string(out.entries[i].digest))
    i = i + 1
  }
  var tags = []
  i = 0
  while i < plan.tags.length() {
    tags = tags.append(json.string(plan.tags[i]))
    i = i + 1
  }
  var platforms = []
  i = 0
  while i < plan.platforms.length() {
    platforms = platforms.append(json.string(plan.platforms[i]))
    i = i + 1
  }
  var fields = [
    ("tool", json.string(out.tool)),
    ("layout", json.string(out.layout)),
    ("digests", json.array(digests)),
    ("tags", json.array(tags)),
    ("platforms", json.array(platforms)),
    ("pushed", json.bool(pushed)),
    ("digest", json.string(report.digest))
  ]
  if lock_path != "" {
    fields = fields.append(("lock", json.string(lock_path)))
    if lock_commit != "" {
      fields = fields.append(("lock_commit", json.string(lock_commit)))
    }
  }
  println(json.encode(json.object(fields)))
}

// The composition without any output: read pokerface.yaml, parse it as the
// build config, capture the Git facts from the context directory, and
// assemble the plan. The command prints; the tests assert on the same plan.
def compose_plan(config_path String, platforms Array[String]) (R, Prepared) {
  case file.read(config_path) {
    (R.error, why) then { return (R.error, "cannot read " + config_path + ": " + why) }
    (R.ok, text) then {
      case src.config.load(text) {
        (R.error, why) then { return (R.error, why) }
        (R.ok, config) then {
          const config_dir = dir_of(config_path)
          const repo_root = src.build.context_dir(config.build.context, config_dir)
          case os.list_dir(repo_root) {
            (R.error, why) then { return (R.error, "build.context: cannot open " + repo_root + ": " + why) }
            (R.ok, _) then {
              const runner = src.git.RealRunner.new()
              case src.build.git_metadata(runner, repo_root) {
                (R.error, why) then { return (R.error, why) }
                (R.ok, metadata) then {
                  case src.build.plan(config, metadata, config_dir, platforms) {
                    (R.error, why) then { return (R.error, why) }
                    (R.ok, plan) then { return (R.ok, Prepared.new(config, metadata, plan)) }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

def dir_of(path String) String {
  var i = path.length() - 1
  while i >= 0 {
    if path.substring(i, 1) == "/" {
      if i == 0 {
        return "/"
      }
      return path.substring(0, i)
    }
    i = i - 1
  }
  return "."
}

// The Dockerfile inside the (already verified) context must exist before a
// build plan is worth printing.
def check_dockerfile(plan src.build.BuildPlan) (R, Bool) {
  case file.read(plan.dockerfile) {
    (R.error, why) then { return (R.error, "build.dockerfile: cannot read " + plan.dockerfile + ": " + why) }
    (R.ok, _) then { return (R.ok, true) }
  }
}

// The human plan. Stable field order, matching the --json keys.
def print_plan(plan src.build.BuildPlan) {
  println(plan_text(plan))
}

// The plan's lines without a trailing newline — print_plan printlns it, the
// tests assert on the substrings.
def plan_text(plan src.build.BuildPlan) String {
  var lines = "image:      " + plan.image + "\n"
  lines = lines + "tags:       " + join(plan.tags, ", ") + "\n"
  lines = lines + "platforms:  " + join(plan.platforms, ", ") + "\n"
  if plan.target != "" {
    lines = lines + "target:     " + plan.target + "\n"
  }
  lines = lines + "dockerfile: " + plan.dockerfile + "\n"
  lines = lines + "context:    " + plan.context + "\n"
  const names = plan.args.keys()
  if names.length() > 0 {
    var pairs = []
    var i = 0
    while i < names.length() {
      pairs = pairs.append(names[i] + "=" + plan.args.get(names[i]))
      i = i + 1
    }
    lines = lines + "args:       " + join(pairs, ", ") + "\n"
  }
  lines = lines + "(dry run — no build performed)"
  return lines
}

// One JSON object per plan; the keys are stable and script-friendly.
def print_plan_json(plan src.build.BuildPlan) {
  var tag_values = []
  var i = 0
  while i < plan.tags.length() {
    tag_values = tag_values.append(json.string(plan.tags[i]))
    i = i + 1
  }
  var platform_values = []
  i = 0
  while i < plan.platforms.length() {
    platform_values = platform_values.append(json.string(plan.platforms[i]))
    i = i + 1
  }
  var arg_values = []
  const names = plan.args.keys()
  i = 0
  while i < names.length() {
    arg_values = arg_values.append(json.object([
      ("name", json.string(names[i])),
      ("value", json.string(plan.args.get(names[i])))
    ]))
    i = i + 1
  }
  var fields = [
    ("image", json.string(plan.image)),
    ("tags", json.array(tag_values)),
    ("platforms", json.array(platform_values))
  ]
  if plan.target != "" {
    fields = fields.append(("target", json.string(plan.target)))
  }
  fields = fields.append(("dockerfile", json.string(plan.dockerfile)))
  fields = fields.append(("context", json.string(plan.context)))
  fields = fields.append(("args", json.array(arg_values)))
  println(json.encode(json.object(fields)))
}

def join(items Array[String], sep String) String {
  var out = ""
  var i = 0
  while i < items.length() {
    if i > 0 {
      out = out + sep
    }
    out = out + items[i]
    i = i + 1
  }
  return out
}

// pokerface CLI routing (T1.1): command dispatch, help text, and usage
// errors. Shared constants and Flags live in src/src.common.emo; command
// handlers live in src/commands/*.
require "os"

// Aliases for test compatibility; the definitions live in src/src.common.emo.
const exit_ok = src.common.exit_ok
const exit_failure = src.common.exit_failure
const exit_usage = src.common.exit_usage
const exit_git = src.common.exit_git
const exit_metadata = src.common.exit_metadata
const exit_auth = src.common.exit_auth
const exit_network = src.common.exit_network
const exit_integrity = src.common.exit_integrity
const exit_runtime = src.common.exit_runtime
const version = src.common.version

def eprint(text String) {
  src.common.eprint(text)
}

def help_text() String {
  return (
    "pokerface " + version + " — distribute container images through Git\n"
    + "\n"
    + "Usage:\n"
    + "  pokerface [global flags] <command> [args]\n"
    + "\n"
    + "Commands:\n"
    + "  resolve    Print the resolution chain of a repository reference\n"
    + "  pull       Fetch an image, verify it, and import it into the local runtime\n"
    + "  build      Build and push the image described by pokerface.yaml\n"
    + "  config     Show the effective configuration\n"
    + "  cache      Inspect and manage the local cache\n"
    + "  version    Print the version\n"
    + "\n"
    + "Global flags:\n"
    + "  --config <path>   Configuration file path\n"
    + "  --verbose         Verbose logging\n"
    + "  --json            Machine-readable output where supported\n"
    + "  -h, --help        Show this help\n"
    + "\n"
    + "config is not implemented yet; see docs/TASKS.md for the plan.\n"
  )
}

def usage_text() String {
  return (
    "usage: pokerface [--config <path>] [--verbose] [--json] <command> [args]\n"
    + "run `pokerface --help` for the command list\n"
  )
}

def run_version(flags src.common.Flags) Int64 {
  if flags.json {
    println("{\"name\": \"pokerface\", \"version\": \"" + version + "\"}")
  } else {
    println("pokerface " + version)
  }
  return exit_ok
}

def not_implemented(name String, flags src.common.Flags) Int64 {
  return src.errors.report("", name + " is not implemented yet; see docs/TASKS.md", flags.json)
}

def route(argv Array[String]) Int64 {
  var config = ""
  var verbose = false
  var json = false
  var want_help = false
  var command = ""
  var rest = []
  var i = 1
  while i < argv.length() {
    const arg = argv[i]
    case arg {
      "--help" then { want_help = true }
      "-h" then { want_help = true }
      "--verbose" then { verbose = true }
      "--json" then { json = true }
      "--config" then {
        if i + 1 >= argv.length() {
          return src.errors.usage_report("", "--config expects a path argument", json)
        }
        i = i + 1
        config = argv[i]
      }
      _ when arg.starts_with("--config=") then {
        config = arg.substring(9, arg.length() - 9)
      }
      _ when arg.starts_with("-") then {
        // Global flags are handled above. After `pull`, an unrecognized
        // option belongs to the command and is parsed (and rejected) there;
        // other commands have no command-specific options yet.
        if command == "pull" || command == "cache" {
          rest = rest.append(arg)
        } else {
          return src.errors.usage_report("", "unknown option " + arg, json)
        }
      }
      _ when command == "" then { command = arg }
      _ then { rest = rest.append(arg) }
    }
    i = i + 1
  }

  if want_help {
    println(help_text())
    return exit_ok
  }

  if command == "" {
    eprint(usage_text())
    return exit_usage
  }

  const flags = src.common.Flags.new(config, verbose, json)
  case command {
    "version" then { return run_version(flags) }
    "resolve" then { return src.commands.resolve.run(flags, rest, src.settings.RealEnv.new()) }
    "pull" then { return src.commands.pull.run(flags, rest, src.settings.RealEnv.new()) }
    "build" then { return not_implemented(command, flags) }
    "config" then { return not_implemented(command, flags) }
    "cache" then { return src.commands.cache.run(flags, rest, src.settings.RealEnv.new()) }
    _ then {
      return src.errors.usage_report("", "unknown command \"" + command + "\"", json)
    }
  }
}

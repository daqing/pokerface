// Shared CLI pieces (T1.9 split): exit codes, the parsed global flags, and
// stderr output. Routing lives in src/cli.emo; command handlers in
// src/commands/* depend on this module, never on the router, so the
// dependency graph stays acyclic.

require "os"

// Stable exit codes (T1.16). 0 success, 1 unclassified failure, 2 usage;
// 3-8 are the fixed categories from docs/spec/errors.md.
const exit_ok = 0
const exit_failure = 1
const exit_usage = 2
const exit_git = 3
const exit_metadata = 4
const exit_auth = 5
const exit_network = 6
const exit_integrity = 7
const exit_runtime = 8

const version = "0.3.3"

class Flags {
  def init(config String, verbose Bool, json Bool) {
    self.config = config
    self.verbose = verbose
    self.json = json
  }
}

def eprint(text String) {
  const (R.ok, _) = os.write(2, text)
}
